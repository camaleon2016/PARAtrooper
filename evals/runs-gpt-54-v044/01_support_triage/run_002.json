          "ref": "cap.crm_read",
          "note": "The prompt permits lookup of any customer, and the CRM token can read every customer record."
        },
        {
          "ref": "cap.email_send",
          "note": "Routine responses are sent directly; the mail token can send to any address."
        }
      ],
      "toxic_combination": [
