      "inherent_risk": "critical",
      "residual_risk": "high",
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:runtime notes",
          "observation": "Customer ticket messages come from a public support widget and are therefore untrusted content."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The database connection uses the service role, bypasses row level security, and a table of integration tokens sits in the same database."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "Rows inserted into support_messages are shown back to the customer, creating an attacker-readable egress channel."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The IDE client asks the developer to approve each tool call and shows the SQL, but developers approve many calls in a session, so the gate is high-volume raw-action review."
        }
      ],
      "recommendations": [
        {
