  "findings": [
    {
      "finding_id": "f.tc1_ticket_exfil_to_customer",
      "title": "Lethal trifecta (TC1): customer ticket content can steer service-role SQL reads and write a reply visible to the customer",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Untrusted customer-authored content enters support_messages."
        },
        {
          "ref": "cap.sql_read",
          "note": "execute_sql reads from the database with a service role that bypasses row level security and can read integration tokens."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "execute_sql inserts into support_messages, and rows are shown back to the customer."
        }
      ],
      "toxic_combination": [
        "in.ticket_message",
        "cap.sql_read",
        "cap.sql_write_reply",
        "ctl.tool_call_prompt"
      ],
