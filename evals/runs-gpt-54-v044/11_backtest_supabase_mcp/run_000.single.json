      "inherent_risk": "critical",
      "residual_risk": "high",
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:runtime notes",
          "observation": "Customer ticket messages are written through a public support widget and are shown back to the customer from support_messages, making the source untrusted and the write path an attacker-reachable egress channel."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The database connection uses the service role, which bypasses row level security, and a table of integration tokens sits in the same database, so execute_sql read has broad access to restricted data."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The IDE client asks the developer to approve each tool call and shows the SQL, but developers approve many calls in a session, which is high approval volume and creates approval-fatigue risk."
        },
        {
          "locator": "artifacts:configuration",
          "observation": "The Supabase MCP server is installed from @latest and definitions are not pinned, so the tool surface can change after prior approval."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Replace the service-role read path with least-privilege credentials that cannot read integration tokens and cannot bypass row level security.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "ISO_42001",
              "id": "A.6.2.6",
