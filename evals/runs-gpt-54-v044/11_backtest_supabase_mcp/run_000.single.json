      "finding_id": "fin.tc1_customer_ticket_to_customer_visible_exfil",
      "title": "Lethal trifecta (TC1): customer ticket content can induce restricted database reads and customer-visible exfiltration",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Untrusted customer-authored content enters context from the public support widget."
        },
        {
          "ref": "cap.sql_read",
          "note": "execute_sql can read restricted data using a service role that bypasses row level security and reaches integration tokens."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "execute_sql can insert support_messages rows that are shown back to the customer."
        }
      ],
      "toxic_combination": [
