            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Constrain customer-visible writes to a bound ticket/recipient record so model-generated SQL cannot choose arbitrary visible rows or channels.",
          "priority": "p1",
