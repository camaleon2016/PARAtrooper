  "findings": [
    {
      "finding_id": "f.tc1_ticket_to_db_reply_exfil",
      "title": "Lethal trifecta (TC1): customer ticket content can steer service-role SQL reads and exfiltrate sensitive database data back through support_messages",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Untrusted customer-authored content enters through the public support widget."
        },
        {
          "ref": "cap.sql_read",
          "note": "execute_sql runs with service role and bypasses row level security, so it can read restricted data including integration tokens."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "insert into support_messages is shown back to the customer, creating attacker-reachable egress."
        }
      ],
