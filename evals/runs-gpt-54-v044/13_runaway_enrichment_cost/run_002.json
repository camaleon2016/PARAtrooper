        "projected_risk": "high",
        "watch_signal": "Median lookup retries, total calls per batch, sub-agent count, and batch runtime rise above the current nightly baseline."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "prompt.md:2-3",
          "observation": "The agent is told to retry failed or incomplete lookups and to keep going until every row is complete."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no maximum on steps, runtime, retries, or sub agents, and sub agents can spawn their own researchers."
        },
        {
          "locator": "runtime notes",
          "observation": "The nightly batch contains 40,000 rows and about 3 percent have malformed company names that never return a complete result."
        },
        {
          "locator": "runtime notes",
          "observation": "enrich.lookup is billed per call and uses an API key and monthly quota shared with sales and marketing."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no spend alert on the enrichment account."
        }
      ],
