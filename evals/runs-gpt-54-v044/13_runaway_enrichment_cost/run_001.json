  "findings": [
    {
      "finding_id": "f01",
      "title": "Spend loop (TC6): unbounded retries and recursive delegation can exhaust shared enrichment quota",
      "horizon": "present",
      "finding_kind": "property",
      "affected_refs": [
        "cap.enrich_lookup",
        "cap.spawn_researcher",
        "store.shared_quota"
      ],
      "inherent_risk": "critical",
      "residual_risk": "critical",
      "confidence": "high",
      "evidence": [
        {
          "locator": "prompt.md:1-3",
          "observation": "The prompt says to keep going until every row is complete and to retry or spawn a researcher when a lookup fails or looks incomplete."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no maximum on steps, runtime, retries, or sub agents, and sub agents can spawn their own researchers."
        },
        {
          "locator": "runtime notes",
          "observation": "enrich.lookup is billed per call, the API key and monthly quota are shared with sales and marketing, and their tools stop working when the quota runs out."
        },
        {
          "locator": "runtime notes",
          "observation": "The nightly batch is 40,000 rows and about 3 percent have malformed company names that never return a complete result."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no spend alert on the enrichment account."
        }
      ],
      "recommendations": [
