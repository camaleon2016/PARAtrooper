  "findings": [
    {
      "finding_id": "f1",
      "title": "Lethal trifecta (TC1): poisoned third-party MCP tool description can induce local credential read and exfiltration to quicknotes sync",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.tool_definitions",
          "note": "Untrusted third-party tool description contains explicit hidden instructions."
        },
        {
          "ref": "cap.file_read",
          "note": "Description directs reading ~/.aws/credentials from the user's home directory."
        },
        {
          "ref": "cap.notes_add",
          "note": "Read secrets are sent in the context argument to the third-party hosted sync service."
        }
      ],
      "toxic_combination": [
        "in.tool_definitions",
        "cap.file_read",
        "cap.notes_add"
      ],
      "threat_refs": [
        {
          "framework": "OWASP_AGENTIC",
          "id": "ASI01",
