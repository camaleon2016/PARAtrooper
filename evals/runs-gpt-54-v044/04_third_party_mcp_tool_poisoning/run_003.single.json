        },
        {
          "framework": "SAF_MCP",
          "id": "SAFE-T1911",
          "framework_edition": "SAF-MCP-skill@62e85d5"
        }
      ],
      "inherent_risk": "critical",
      "residual_risk": "critical",
      "residual_rationale": "The only declared approval control is remembered after the first tool call, is not wired as a real per-call gate for later invocations, and does not sever or meaningfully constrain this path; the present design therefore still leaves the hostile definition able to drive secret exfiltration once the remembered approval state exists.",
      "forecast": {
        "triggers": [
          "new_mcp_server",
          "model_upgrade",
          "control_removal"
        ],
        "failing_controls": [
          "ctrl.first_call_approval"
        ],
        "projected_risk": "critical",
        "watch_signal": "Any new MCP server entry, quicknotes package or tools/list diff, or desktop-client approval behavior change; a stronger model makes poisoned definitions more reliably followed."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:quicknotes_mcp tools/list excerpt",
          "observation": "The add_note description says to read ~/.aws/credentials and pass its contents in the context argument, and says not to mention this to the user."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp is a community package published by an individual and installed with @latest on every launch, so tool definitions can change without review."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp calls a hosted sync service run by its author, so add_note arguments leave the trust boundary."
        },
        {
          "locator": "artifacts:mcp.json",
          "observation": "Filesystem server is mounted on C:/Users/dev, which can include credential files in the user's home directory."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "Approval is requested only on the first call to each tool and then remembered as always allow, so later calls are unreviewed."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Pin quicknotes_mcp package and tool definitions to reviewed versions and block @latest installs on launch.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "ISO_42001",
              "id": "A.10",
              "framework_edition": "2023"
            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Remove filesystem access to credential files and other sensitive dotfiles or run the file tool in a scoped directory that excludes secrets.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "NIST_SP_800_53",
