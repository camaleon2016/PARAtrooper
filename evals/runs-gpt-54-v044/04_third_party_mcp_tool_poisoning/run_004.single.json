  "findings": [
    {
      "finding_id": "f1",
      "title": "Lethal trifecta (TC1): unpinned third-party MCP tool definition poisons the agent into reading local credentials and exfiltrating them to quicknotes",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.tool_definitions",
          "note": "Untrusted tool description instructs the model to read ~/.aws/credentials and include it in a tool argument."
        },
        {
          "ref": "cap.file_read",
          "note": "Reads restricted credential material from the user's home directory."
        },
        {
          "ref": "cap.notes_add",
          "note": "Sends the stolen content to a hosted sync service operated by the package author."
        }
      ],
      "toxic_combination": [
        "in.tool_definitions",
        "cap.file_read",
        "cap.notes_add"
      ],
      "threat_refs": [
