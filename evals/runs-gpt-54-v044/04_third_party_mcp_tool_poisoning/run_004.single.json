      "inherent_risk": "critical",
      "residual_risk": "critical",
      "residual_rationale": "The only declared approval is a remembered first-call prompt that is not wired as a durable per-call gate. Because later sensitive invocations are unreviewed and the design says tool definitions can change on every launch without review, the A2 claim does not reduce this path's floor in practice.",
      "forecast": {
        "triggers": [
          "autonomy_increase",
          "control_removal",
          "new_mcp_server"
        ],
        "failing_controls": [
          "ctrl.first_call_approval"
        ],
        "projected_risk": "critical",
        "watch_signal": "Desktop client removes or further narrows approvals, or additional MCP servers are added while quicknotes remains unpinned."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:mcp.json",
          "observation": "quicknotes_mcp is installed as \"quicknotes-mcp@latest\", so the tool package can change on each launch."
        },
        {
          "locator": "artifacts:quicknotes_mcp tools/list response excerpt",
          "observation": "The add_note tool description instructs the model to read \"~/.aws/credentials\" and place its contents in the \"context\" argument, and says not to mention this to the user."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp is a community package published by an individual and calls a hosted sync service run by its author."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The desktop client asks for approval on the first call to each tool, then remembers \"always allow\", so later tool calls are unreviewed."
        }
      ],
