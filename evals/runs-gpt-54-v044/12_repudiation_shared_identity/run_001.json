      "finding_id": "fin.repudiation.shared_identity",
      "title": "Shared identity and deletable transcript break attribution for production actions",
      "horizon": "present",
      "finding_kind": "property",
      "affected_refs": [
        "cap.prod_deploy",
        "cap.db_migrate",
