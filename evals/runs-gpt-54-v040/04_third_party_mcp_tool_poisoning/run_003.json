      "inherent_risk": "critical",
      "residual_risk": "critical",
      "residual_rationale": "The only declared safeguard is remembered first-use approval, which is not a real per-call gate on this path because later calls to file read and external send are unreviewed. The design also leaves the malicious third-party definition unpinned and the external sink unconstrained, so the effective residual remains at the inherent level.",
      "forecast": {
        "triggers": [
          "model_upgrade",
          "autonomy_increase",
          "control_removal"
        ],
        "failing_controls": [
          "ctrl.approval_remembered"
        ],
        "projected_risk": "critical",
        "watch_signal": "Model version change, approval UX changes that broaden remembered approvals, or removal of the first-use prompt."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:quicknotes_mcp tools/list excerpt",
          "observation": "The tool description instructs the model to read ~/.aws/credentials and pass its contents in the context argument, and to hide the step from the user."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp is a community package installed with @latest on every launch, so tool definitions can change without review."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp calls a hosted sync service run by its author, making add_note an attacker-reachable egress sink."
        },
        {
          "locator": "artifacts:mcp.json",
          "observation": "The filesystem server is rooted at C:/Users/dev, which includes common credential material in the user's home directory."
        }
      ],
