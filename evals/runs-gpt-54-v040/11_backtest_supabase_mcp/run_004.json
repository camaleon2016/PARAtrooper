        "triggers": [
          "autonomy_increase",
          "control_removal",
          "data_scope_expansion",
          "model_upgrade"
        ],
        "failing_controls": [
          "ctl.tool_call_prompt"
        ],
        "projected_risk": "critical",
        "watch_signal": "Any reduction of per-call approval, remembered approvals, higher unattended step limits, or broader database scope for the service role should trigger reassessment."
      },
      "evidence": [
        {
          "locator": "artifacts:runtime notes",
          "observation": "The database connection uses the service role, which bypasses row level security, and a table of integration tokens sits in the same database."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "Customers write ticket messages through the public support widget, so ticket content is an untrusted source."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "Rows in support_messages are shown back to the customer, making inserts into that table an attacker-readable egress channel."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The IDE client asks the developer to approve each tool call and shows the SQL, but developers approve many calls in a session, so the gate earns only one tier of credit for high approval volume."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Replace the service-role read path with a credential scope that cannot read integration tokens or other non-ticket tables.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "ISO_42001",
              "id": "A.6.2.6"
            },
            {
              "framework": "NIST_SP_800_53",
              "id": "AC-6"
            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Constrain support_messages writes to approved response templates or field-level bindings so query results cannot be copied into customer-visible rows.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "NIST_AI_RMF",
              "id": "MANAGE 1.3"
            },
            {
              "framework": "NIST_SP_800_53",
              "id": "SC-7"
            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "corrective",
          "mechanism": "behavioral",
          "action": "Train reviewers to treat customer-authored ticket text as hostile and scrutinize read-then-write SQL sequences, but do not rely on reviewer training as the main control.",
          "priority": "p2",
          "audience": "reviewer",
