      "finding_id": "f.tc1.ticket_to_sql_to_customer_reply",
      "title": "Lethal trifecta (TC1): customer ticket content can steer service-role SQL reads and exfiltrate restricted data through support_messages",
      "horizon": "present",
      "finding_kind": "path",
