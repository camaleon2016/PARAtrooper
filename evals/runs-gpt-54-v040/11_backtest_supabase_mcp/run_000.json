          "autonomy_increase",
          "model_upgrade",
          "control_removal",
          "longer_task_horizon"
        ],
        "failing_controls": [
          "ctl.tool_call_prompt"
        ],
        "projected_risk": "critical",
        "watch_signal": "Approval prompt removed or narrowed, approval counts per developer session remain high, or model id/version changes."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:runtime notes",
          "observation": "Customer ticket messages are written through a public support widget and rows in support_messages are shown back to the customer, making ticket content an untrusted source and reply insertion an attacker-readable egress."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The database connection uses the service role and bypasses row level security; a table of integration tokens sits in the same database, so SQL read scope is broader than the developer's stated request."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The IDE client asks the developer to approve each tool call and shows the SQL, but developers approve many calls in a session, which makes the gate high-volume and vulnerable to approval fatigue."
        },
        {
          "locator": "artifacts:developer prompt",
          "observation": "The prompt is only to show latest open support tickets; any reply write back to the customer would be outside the explicit trusted request."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Replace service-role SQL reads with a least-privilege credential or brokered query layer that cannot read integration tokens and respects tenant and row boundaries.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "ISO_42001",
              "id": "A.6.2.6",
              "framework_edition": "2023"
