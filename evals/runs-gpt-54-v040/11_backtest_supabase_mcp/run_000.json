          "note": "Agent can issue SQL reads with service role that bypasses RLS."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "Agent can insert a reply into support_messages that is shown back to the customer."
        }
      ],
      "toxic_combination": [
