              "framework_edition": "Rev5"
            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Block customer-visible writes from the same session used for ticket inspection unless the destination ticket id and allowed content class are bound outside model output.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "ISO_42001",
