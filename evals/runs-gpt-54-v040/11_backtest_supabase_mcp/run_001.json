      "evidence": [
        {
          "locator": "artifacts:runtime notes",
          "observation": "Customer ticket messages are written through a public support widget and rows in support_messages are shown back to the customer, making the source untrusted and the write path an attacker-readable egress channel."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The database connection uses the service role, bypasses row level security, and a table of integration tokens sits in the same database, so the read capability reaches restricted data with shared authority."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The IDE client asks the developer to approve each tool call and shows the SQL, but developers approve many calls in a session, so the gate is raw-action review with high approval volume and only one-tier credit."
        }
      ],
      "recommendations": [
