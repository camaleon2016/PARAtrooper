      "evidence": [
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Customer ticket messages are written through the public support widget and shown back to the customer through support_messages, so they are an untrusted source and a customer-readable egress sink."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The database connection uses the service role and bypasses row level security; a table of integration tokens sits in the same database, making the read capability restricted and broad."
