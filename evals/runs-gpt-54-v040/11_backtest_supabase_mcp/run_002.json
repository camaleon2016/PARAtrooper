  "findings": [
    {
      "finding_id": "fin.tc1_customer_to_secret_echo",
      "title": "Lethal trifecta (TC1): customer-written ticket content can steer SQL reads and leak restricted database data back to the customer-visible support_messages table",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Untrusted customer-authored content enters the ticket context."
        },
        {
          "ref": "cap.sql_read",
          "note": "execute_sql reads from the database using a service role that bypasses row level security."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "execute_sql inserts a reply into support_messages, which the customer can read back."
        }
      ],
      "toxic_combination": [
        "in.ticket_message",
        "cap.sql_read",
        "cap.sql_write_reply",
        "ctl.tool_call_prompt"
      ],
