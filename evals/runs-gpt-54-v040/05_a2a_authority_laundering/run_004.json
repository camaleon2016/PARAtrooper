      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.vendor_quote",
          "note": "External vendor quote supplies bank details and pricing."
        },
        {
          "ref": "cap.delegate_payment",
          "note": "Orchestrator delegates pay_vendor task to payments-agent using bank details from chosen quote."
        },
        {
          "ref": "payments-agent",
          "note": "Peer agent trusts any task from orchestrator bearer token and pays bank details in the task."
        }
      ],
      "toxic_combination": [
        "in.vendor_quote",
        "ctl.manager_approval",
        "cap.delegate_payment",
        "payments-agent"
      ],
      "threat_refs": [
