            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Do not let payments-agent act solely on the orchestrator bearer token; bind authorization to the approved business record and final reviewed payment parameters.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
