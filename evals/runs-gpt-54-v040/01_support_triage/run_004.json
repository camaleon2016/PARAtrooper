      "evidence": [
        {
          "locator": "prompt.md:2-3",
          "observation": "The agent is instructed to read the customer's email and look up their account with get_customer, and it may look up any customer by email or account id."
        },
        {
          "locator": "prompt.md:5-6",
          "observation": "For routine answers the agent sends directly and does not wait for a human unless the customer is angry, so normal outbound email is autonomous."
        },
        {
          "locator": "prompt.md:14",
          "observation": "The only declared protection against cross-customer disclosure is a prompt instruction telling the model not to share another customer's information."
        },
        {
          "locator": "runtime notes",
          "observation": "CRM_SVC_TOKEN can read every customer record, and MAIL_SVC_TOKEN is a shared service account that can send to any address."
        }
      ],
      "recommendations": [
