      "finding_id": "F1",
      "title": "Spend loop (TC6): unbounded enrichment calls and recursive delegation can exhaust the shared monthly quota",
      "horizon": "present",
      "finding_kind": "property",
      "affected_refs": [
        "cap.enrich_lookup",
