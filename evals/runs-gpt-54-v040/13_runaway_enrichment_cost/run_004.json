        "failing_controls": [],
        "projected_risk": "high",
        "watch_signal": "Median steps or runtime per nightly batch rises, or recursive researcher spawning appears in orchestration logs."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "prompt.md:1-3",
          "observation": "The prompt instructs the agent to retry failed or incomplete lookups, spawn researcher sub agents, and keep going until every row is complete."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no maximum on steps, runtime, retries, or sub agents, and sub agents can spawn their own researchers."
        },
        {
          "locator": "runtime notes",
          "observation": "The nightly batch is 40,000 rows and about 3 percent have malformed company names that never return a complete result, creating a persistent failure set."
        },
        {
          "locator": "runtime notes",
          "observation": "enrich.lookup is billed per call, and the API key and monthly quota are shared with other teams, so runaway use depletes a consequential shared resource."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no spend alert on the enrichment account."
        }
      ],
