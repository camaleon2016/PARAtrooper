      "forecast": {
        "triggers": [
          "longer_task_horizon",
          "autonomy_increase",
          "control_removal",
          "intended_purpose_change"
        ],
        "failing_controls": [],
        "projected_risk": "critical",
        "watch_signal": "Median steps per batch, retries per malformed row, or spawned researcher count rising without new limits."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "prompt.md:2-3",
          "observation": "The prompt says to retry or spawn a researcher and to keep going until every row is complete."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no maximum on steps, runtime, retries, or sub agents, and sub agents can spawn their own researchers."
        },
        {
          "locator": "runtime notes",
          "observation": "enrich.lookup is billed per call and the API key and monthly quota are shared with sales and marketing, so runaway use can deny service to other teams for the rest of the month."
        },
        {
          "locator": "runtime notes",
          "observation": "The nightly batch is 40,000 rows and about 3 percent have malformed company names that never return a complete result, creating a persistent failure set that drives repeated paid lookups."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no spend alert on the enrichment account."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Enforce a hard per-run call budget and monthly spend cap on cap.enrich_lookup, with the run failing closed when the budget is reached.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "NIST_AI_RMF",
              "id": "MANAGE 2.4",
              "framework_edition": "1.0"
            },
            {
              "framework": "NIST_SP_800_53",
              "id": "SC-5",
              "framework_edition": "rev5"
            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Set maximum unattended steps, retries per row, runtime, delegation depth, and total sub-agent count; route unresolved rows to a human queue instead of retrying indefinitely.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "ISO_42001",
              "id": "8.2",
              "framework_edition": "2023"
            }
          ],
          "rmf_function": "MEASURE"
        },
        {
          "category": "detective",
          "mechanism": "structural",
          "action": "Add quota and spend alerts with thresholds well below monthly exhaustion, and alert on anomalous retry or researcher spawn rates.",
