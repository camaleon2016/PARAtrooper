  "rating": {
    "inherent": "critical",
    "residual": "high",
    "forecast": "critical",
    "rationale": "Present risk is dominated by a complete untrusted-to-confidential-egress path: web content can be written into memory, later recalled as if it were the user's own instruction, used to read confidential drive content, and sent externally by email without approval. The only declared control on that path is behavioral prompt handling, so residual drops only one tier from critical to high. Forecast returns to critical if that instruction-only control decays under model upgrade, longer task horizon, or autonomy increase. Manual validation applied because scripts were unavailable."
  },
  "limitations": [
    "This assessment reflects the declared design and configuration in prompt.md and runtime notes, not observed runtime behavior.",
    "No tool schema, memory store implementation, logging configuration, or runtime enforcement details were provided, so controls and data flows were assessed from the supplied notes only.",
    "No source artifact describes whether fetched web content is user-approved, sanitized, or domain-restricted, which limits confidence on intake-side mitigations."
  ]
