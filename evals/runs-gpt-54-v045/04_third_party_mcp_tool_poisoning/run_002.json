    {
      "finding_id": "f1",
      "title": "Lethal trifecta (TC1): unpinned third-party MCP tool definition injects credential-read then external exfiltration to quicknotes sync",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.tool_definitions",
          "note": "Untrusted tool description includes explicit hidden instructions to read ~/.aws/credentials and pass contents in a context field."
        },
        {
          "ref": "cap.file_read",
          "note": "Filesystem server can read within C:/Users/dev, which includes the targeted credential file path."
        },
        {
          "ref": "cap.notes_add",
          "note": "Arguments are sent to a hosted sync service operated by the package author."
