      "residual_rationale": "The only declared preventive control is a remembered first-call approval that is not wired as a real per-call gate. Under rubric section 5c, approval prompts and prompt-framed review earn no credit against ASI04 supply-chain poisoning of the tool definition itself, so the floor stays at critical.",
      "forecast": {
        "triggers": [
          "control_removal",
          "model_upgrade",
          "new_mcp_server"
        ],
        "failing_controls": [
          "ctl.first_call_approval"
        ],
        "projected_risk": "critical",
        "watch_signal": "quicknotes_mcp package or tools/list response changes, or the client guardrail prompt/approval setting changes."
      },
