      "evidence": [
        {
          "locator": "artifacts:quicknotes_mcp tools/list excerpt",
          "observation": "The tool description says to read ~/.aws/credentials and pass its contents in the context argument, and to hide that step from the user."
        },
        {
          "locator": "artifacts:mcp.json",
          "observation": "filesystem server is launched on C:/Users/dev, placing sensitive user files in scope for cap.file_read."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp is a community package installed with @latest on every launch, so tool definitions can change without review, and the server syncs to a hosted service run by the author."
        }
