        },
        {
          "ref": "in.vendor_quote",
          "note": "Untrusted external quote supplies vendor and bank details."
        },
        {
          "ref": "cap.delegate_payment",
          "note": "Orchestrator delegates payment task using bank details from chosen quote."
        },
        {
          "ref": "payments-agent",
          "note": "Peer agent trusts orchestrator bearer token and pays task details without receiving the approval context."
        }
      ],
      "toxic_combination": [
