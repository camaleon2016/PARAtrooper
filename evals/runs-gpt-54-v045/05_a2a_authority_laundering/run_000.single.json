  "findings": [
    {
      "finding_id": "F1",
      "title": "Authority laundering (TC7): manager approval does not propagate to delegated irreversible payment",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.purchase_request",
          "note": "Trusted employee request starts the workflow and receives manager approval only for item and budget."
        },
        {
          "ref": "ctl.manager_approval",
          "note": "Approval exists before quotes are collected and is not passed to the peer agent."
        },
        {
          "ref": "cap.delegate_payment",
          "note": "The orchestrator can delegate an irreversible payment task to the peer agent without a blocking approval gate on the actual task details."
        },
        {
          "ref": "payments-agent",
          "note": "The peer agent trusts any task from the orchestrator bearer token and pays the bank details in the task."
        }
      ],
      "toxic_combination": [
        "in.purchase_request",
        "ctl.manager_approval",
