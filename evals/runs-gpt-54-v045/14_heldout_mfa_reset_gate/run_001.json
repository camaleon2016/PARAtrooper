        },
        {
          "locator": "runtime notes:3",
          "observation": "Contractors and vendors can email tickets in, and the requester field is the email sender, making the source untrusted."
        },
        {
          "locator": "runtime notes:4",
          "observation": "The temporary pass goes to whoever opened the ticket, not to the account owner."
        }
