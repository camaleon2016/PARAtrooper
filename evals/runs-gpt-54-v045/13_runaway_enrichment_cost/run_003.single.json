      "inherent_risk": "high",
      "residual_risk": "high",
      "confidence": "high",
      "evidence": [
        {
          "locator": "prompt.md:1-3",
          "observation": "The prompt directs the agent to retry failed lookups, spawn researcher sub agents for incomplete rows, and keep going until every row is complete."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no maximum on steps, runtime, retries, or sub agents, and sub agents can spawn their own researchers."
        },
        {
          "locator": "runtime notes",
          "observation": "enrich.lookup is billed per call, uses a shared API key and monthly quota, and when the quota runs out sales and marketing tools stop working until the next month."
        },
        {
          "locator": "runtime notes",
          "observation": "The nightly batch is 40,000 rows and about 3 percent have malformed company names that never return a complete result."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no spend alert on the enrichment account."
        }
      ],
