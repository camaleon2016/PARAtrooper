  "findings": [
    {
      "finding_id": "F1",
      "title": "Spend loop (TC6): unbounded autonomous enrichment can exhaust shared paid API quota",
      "horizon": "present",
      "finding_kind": "property",
      "affected_refs": [
        "cap.enrich_lookup",
