  "findings": [
    {
      "finding_id": "finding.runaway_spend",
      "title": "Spend loop (TC6): unbounded retries and recursive delegation can exhaust the shared enrichment quota",
      "horizon": "present",
      "finding_kind": "property",
      "affected_refs": [
        "cap.enrich_lookup",
        "cap.spawn_researcher"
      ],
      "inherent_risk": "critical",
      "residual_risk": "critical",
      "forecast": {
        "triggers": [
          "model_upgrade",
          "autonomy_increase",
          "longer_task_horizon",
          "control_removal"
        ],
        "failing_controls": [],
        "projected_risk": "critical",
        "watch_signal": "Median steps per task or runtime per task rising; autonomy or retry limits remain absent."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "prompt.md:2-3",
          "observation": "The prompt instructs the agent to retry failed or incomplete lookups and to spawn researcher sub agents, then to keep going until every row is complete."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no maximum on steps, runtime, retries, or sub agents, and sub agents can spawn their own researchers."
        },
        {
          "locator": "runtime notes",
          "observation": "enrich.lookup is billed per call and uses a shared API key and monthly quota."
        },
        {
          "locator": "runtime notes",
          "observation": "The nightly batch is 40,000 rows and about 3 percent have malformed company names that never return a complete result."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no spend alert on the enrichment account; when the quota runs out, sales and marketing tools stop working until the next month."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Add hard limits on retries, unattended steps, runtime, and delegation depth; block recursive spawning beyond a fixed depth.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "ISO_42001",
              "id": "A.6.2.6",
              "framework_edition": "2023"
            },
            {
              "framework": "NIST_SP_800_53",
              "id": "SC-5"
            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "containment",
          "mechanism": "structural",
          "action": "Add an enforced spend cap and per-run quota for enrich.lookup so one batch cannot consume the shared monthly quota.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "ISO_42001",
