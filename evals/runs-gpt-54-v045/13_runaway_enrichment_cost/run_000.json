        "projected_risk": "high",
        "watch_signal": "Median retries, task runtime, or spawned researcher count rises; no present structural limits exist, so the risk remains high until hard limits are added."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "prompt.md:1-3",
          "observation": "The prompt says to retry failed or incomplete lookups, or spawn a researcher, and to keep going until every row is complete."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no maximum on steps, runtime, retries, or sub agents, and sub agents can spawn their own researchers."
        },
        {
          "locator": "runtime notes",
          "observation": "enrich.lookup is billed per call, and the API key and monthly quota are shared with sales and marketing teams."
        },
        {
          "locator": "runtime notes",
          "observation": "The nightly batch is 40,000 rows and roughly 3 percent have malformed company names that never return a complete result."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no spend alert on the enrichment account."
        }
      ],
