      "evidence": [
        {
          "locator": "artifacts:runtime notes",
          "observation": "Anyone on GitHub can open issues in the public repository, so issue content is untrusted."
        },
        {
          "locator": "artifacts:configuration",
          "observation": "The desktop client runs the GitHub MCP server and therefore exposes GitHub tools to the agent."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The personal access token has repo scope across every repository the user owns, public and private, so private repo reads are available under the user's authority."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The client asks for approval per tool call, but arguments are collapsed by default and users approve many calls per session, so the gate is a high-volume model-summary review rather than raw action review."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The user prompt asks to look at open issues in the public repo, which creates a path for public issue content into subsequent tool decisions."
        }
