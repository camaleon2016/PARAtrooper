  "findings": [
    {
      "finding_id": "fin.tc1_public_issue_to_private_read_to_public_pr",
      "title": "Lethal trifecta (TC1): untrusted public issue content can drive private repo reads and exfiltrate data through a public pull request",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.public_issue",
          "note": "Public issue text is attacker-authorable and enters the agent context."
        },
        {
          "ref": "cap.read_private_repo",
          "note": "The GitHub token allows reads across every repository the user owns, including private repositories."
        },
        {
          "ref": "cap.create_pr_public",
          "note": "A pull request to a public repository is attacker-readable egress."
        }
      ],
      "toxic_combination": [
        "in.public_issue",
        "cap.read_private_repo",
        "cap.create_pr_public",
        "ctl.tool_call_prompt"
      ],
      "threat_refs": [
        {
          "framework": "OWASP_AGENTIC",
          "id": "ASI01",
          "framework_edition": "2026",
          "name": "Agent Goal Hijack"
        },
        {
          "framework": "OWASP_AGENTIC",
          "id": "ASI02",
          "framework_edition": "2026",
          "name": "Tool Misuse and Exploitation"
        },
        {
          "framework": "MITRE_ATLAS",
          "id": "AML.T0051",
          "framework_edition": "2026.09",
          "name": "LLM Prompt Injection"
        },
        {
          "framework": "MITRE_ATLAS",
          "id": "AML.T0086",
          "framework_edition": "2026.09",
          "name": "Exfiltration via AI Agent Tool Invocation"
        },
        {
          "framework": "SAF_MCP",
          "id": "SAFE-T1102",
          "framework_edition": "SAF-MCP-skill@62e85d5",
          "name": "Prompt Injection (Multiple Vectors)"
        },
        {
          "framework": "SAF_MCP",
          "id": "SAFE-T1914",
          "framework_edition": "SAF-MCP-skill@62e85d5",
          "name": "Tool-to-Tool Exfil"
        }
      ],
      "inherent_risk": "critical",
      "residual_risk": "high",
      "forecast": {
        "triggers": [
          "model_upgrade",
          "autonomy_increase",
          "control_removal",
          "longer_task_horizon"
        ],
        "failing_controls": [
          "ctl.tool_call_prompt"
        ],
        "projected_risk": "critical",
        "watch_signal": "Model version changes, approval UX changes, approval volume rises, or median steps per task increases."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Anyone on GitHub can open issues in the public repository, so issue content is an untrusted source."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The personal access token has repo scope across every repository the user owns, public and private, so public issue content can influence reads of confidential private repository data."
        },
        {
          "locator": "artifacts:stable_ids",
          "observation": "The design exposes get_file_contents on private repositories and create_pull_request on the public repository, which together form a read-then-egress path."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The client asks for approval per tool call, but arguments are collapsed by default and users approve many calls per session, so the gate is model-summary review at high volume."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Scope the GitHub token and tool permissions to the specific public repository needed for issue triage so public issue content cannot reach private repository contents.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "NIST_SP_800_53",
              "id": "AC-6"
            },
            {
              "framework": "ISO_42001",
              "id": "A.6.2.6",
              "framework_edition": "2023"
            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Replace collapsed, high-volume approval with raw-action review that shows destination, repository, and exact arguments for every sensitive call.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "NIST_AI_RMF",
              "id": "MANAGE 1.3",
              "framework_edition": "1.0"
            },
            {
              "framework": "ISO_42001",
              "id": "A.8",
              "framework_edition": "2023"
            }
          ],
          "rmf_function": "MANAGE"
        }
      ],
