          "locator": "prompt.md:1-4",
          "observation": "The agent processes supplier invoices, updates bank details when the invoice shows new details, and schedules payment."
        },
        {
          "locator": "prompt.md:3-4",
          "observation": "Before payment or bank change, the design requests approval with a one line summary so the clerk can approve quickly."
        },
        {
          "locator": "approval card",
          "observation": "The clerk sees only a one line model summary for approval."
        },
        {
          "locator": "runtime notes",
          "observation": "The card does not show bank account numbers or change history, the clerk approves roughly 150 cards per day, the ERP credential can update any vendor and schedule any payment, and the model is upgraded with the platform with no separate review."
        }
      ],
