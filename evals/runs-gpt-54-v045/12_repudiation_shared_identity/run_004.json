            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Make the provenance record tamper evident and not deletable by the requesting engineer, or replicate it to an append-only audit store outside the chat system.",
          "priority": "p1",
