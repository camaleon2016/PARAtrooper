          "id": "AML.T0083",
          "name": "Credentials from AI Agent Configuration",
          "framework_edition": "2026.09"
        }
      ],
      "inherent_risk": "high",
      "residual_risk": "high",
      "confidence": "high",
      "evidence": [
        {
          "locator": "runtime notes",
          "observation": "The agent uses the on call engineer's personal access token passed in at session start, so production actions are executed and logged under the engineer's own identity."
        },
        {
          "locator": "runtime notes",
          "observation": "Every production action is recorded in the cloud audit log under the engineer's name, not under a distinct agent identity."
        },
        {
          "locator": "runtime notes",
          "observation": "The only record of what the agent was asked, and why it acted, is the chat transcript."
        },
        {
          "locator": "runtime notes",
          "observation": "Engineers can delete their own chat history, so the design lacks tamper-resistant provenance linking request, agent decision, and resulting production action."
        },
        {
          "locator": "prompt.md:1-3",
          "observation": "The prompt authorizes deploy and migration actions on request and instructs the agent not to ask for confirmation, increasing the importance of attributable records for later review."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Introduce a distinct agent identity or delegated sub-identity for production actions and bind each action to immutable request provenance, including requester, prompt, arguments, and resulting action id.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "ISO_42001",
              "id": "A.8",
              "framework_edition": "2023"
            },
            {
              "framework": "NIST_SP_800_53",
