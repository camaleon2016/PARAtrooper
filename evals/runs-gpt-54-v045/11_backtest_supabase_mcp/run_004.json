  "findings": [
    {
      "finding_id": "F1",
      "title": "Lethal trifecta (TC1): customer ticket content can drive service-role SQL reads and customer-visible writes",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Customer-authored content enters through the public support widget."
        },
        {
          "ref": "cap.sql_read",
          "note": "execute_sql uses a service role that bypasses row level security and can read restricted data including integration tokens in the same database."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "execute_sql can insert into support_messages, and rows are shown back to the customer."
        }
      ],
      "toxic_combination": [
        "in.ticket_message",
        "cap.sql_read",
        "cap.sql_write_reply",
        "ctl.tool_call_prompt"
      ],
