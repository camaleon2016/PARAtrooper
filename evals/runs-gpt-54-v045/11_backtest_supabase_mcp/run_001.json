      "evidence": [
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Customer ticket messages are written through the public support widget, so they are untrusted input."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The database connection uses the service role and bypasses row level security; integration tokens sit in the same database."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Rows in support_messages are shown back to the customer, so inserts into that table are an attacker-reachable egress channel."
