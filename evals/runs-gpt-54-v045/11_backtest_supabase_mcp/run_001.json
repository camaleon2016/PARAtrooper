  "findings": [
    {
      "finding_id": "f.tc1_sql_exfil_to_customer",
      "title": "Lethal trifecta (TC1): customer ticket content can steer service-role SQL reads and write restricted data back to a customer-visible table",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Untrusted customer-authored ticket content enters context from the public support widget."
        },
        {
          "ref": "cap.sql_read",
          "note": "Agent can read restricted database content using service-role SQL that bypasses row level security."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "Agent can insert a reply into support_messages, and rows are shown back to the customer."
        }
      ],
      "toxic_combination": [
        "in.ticket_message",
        "cap.sql_read",
        "cap.sql_write_reply",
        "ctl.tool_call_prompt"
