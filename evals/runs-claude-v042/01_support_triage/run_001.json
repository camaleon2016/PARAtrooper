      "title": "Lethal trifecta / confused deputy (TC1 + TC4): untrusted email drives cross-customer CRM read and unrestricted send",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.inbound_email",
          "note": "Attacker-controlled email specifies an email address or account id to look up, with no verification it belongs to the sender."
        },
        {
          "ref": "cap.crm_read",
          "note": "CRM_SVC_TOKEN is broad and not scoped to the requester, so any account's confidential record can be read."
        },
        {
          "ref": "cap.email_send",
          "note": "MAIL_SVC_TOKEN is a shared service account that can send to any address; the draft (which may contain the looked-up record) is sent without approval when classified routine."
