              "framework": "NIST_SP_800_53",
              "id": "AC-4"
            }
          ]
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Add a human approval gate with raw-action review (full recipient and CRM payload visible, not a collapsed summary) for sends containing confidential CRM fields, keeping volume low per reviewer.",
          "priority": "p2",
          "audience": "both"
        },
        {
          "category": "preventive",
          "mechanism": "behavioral",
          "action": "Remove the 'look up any customer by email or account id' grant from the prompt and replace it with an instruction scoped to the requester's own account, as defense in depth alongside the structural fix.",
          "priority": "p3",
          "audience": "developer"
        }
