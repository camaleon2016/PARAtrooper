      "evidence": [
        {
          "locator": "prompt.md:2-3",
          "observation": "Agent may look up any customer by email or account id, not limited to the requester's own account."
        },
        {
          "locator": "prompt.md:5-6",
          "observation": "Routine responses are sent directly without human approval; escalation depends only on detected customer anger, not on data sensitivity or recipient verification."
        },
        {
          "locator": "prompt.md:14",
          "observation": "The only safeguard against cross-customer disclosure is a prompt instruction, which is behavioral and model-dependent."
        },
        {
          "locator": "mcp.json",
          "observation": "crm_mcp and mail_mcp both authenticate with static bearer tokens; no mutual TLS, signed identity, or definition pinning is configured."
        },
        {
          "locator": "runtime notes",
          "observation": "CRM_SVC_TOKEN can read every customer record (broad, not scoped to the requester); MAIL_SVC_TOKEN is a shared service account that can send to any address."
        },
        {
          "locator": "runtime notes",
          "observation": "The model is upgraded with the platform with no separate review, so the behavioral prompt control is exposed to model_upgrade decay with no reassessment trigger built in."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Scope the CRM lookup to the authenticated requester's own account (verify the inbound email's authenticated sender matches the account being queried), making other customers' records unreachable.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
