          "control.prompt_no_share"
        ],
        "projected_risk": "critical",
        "watch_signal": "Model id/version changes without separate review (subject.model.swappable is true), or any increase in autonomous steps/volume without an added approval gate."
      },
      "confidence": "medium",
      "evidence": [
        {
          "locator": "prompt.md:2-3",
          "observation": "Agent is instructed it 'may look up any customer by email or account id,' with no check that this matches the ticket submitter's own identity."
        },
        {
          "locator": "runtime notes",
          "observation": "CRM_SVC_TOKEN can read every customer record; the CRM read capability is not scoped to the requester's own account."
        },
        {
          "locator": "runtime notes",
          "observation": "MAIL_SVC_TOKEN is a shared service account that can send to any address, so a reply is not restricted to the original ticket requester."
        },
        {
          "locator": "prompt.md:14",
          "observation": "The only declared barrier to leaking another customer's data is a single prompt line, a behavioral control the agent itself must choose to obey."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Scope the CRM credential or add an authorization check so get_customer only returns the record matching the authenticated ticket submitter, not any customer by email or account id.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "NIST_AI_RMF",
              "id": "MEASURE 2.7"
            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Restrict mail_mcp.send so replies can only go to the verified email address on the originating ticket, not an address found in or implied by the message body.",
          "priority": "p1",
          "audience": "developer"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Add a human approval gate, with the approver seeing the raw CRM data and destination address, before any email containing another customer's account data is sent.",
          "priority": "p2",
          "audience": "both"
        },
        {
          "category": "detective",
          "mechanism": "structural",
          "action": "Correlate each CRM read with the ticket id and the subsequent outbound email in one audit record, and alert when the read customer id differs from the ticket submitter.",
          "priority": "p2",
          "audience": "developer"
        }
      ],
