  "findings": [
    {
      "finding_id": "finding.confused_deputy_trifecta",
      "title": "Lethal trifecta / confused deputy (TC1, TC4): untrusted ticket drives unrestricted CRM lookup and arbitrary-recipient send",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.inbound_email",
          "note": "Attacker-controlled ticket content can request lookup of any customer by email or account id (prompt.md:2-3 explicitly permits this)."
        },
        {
          "ref": "cap.crm_read",
          "note": "Agent calls get_customer using CRM_SVC_TOKEN, which can read every customer record regardless of who is asking."
        },
        {
          "ref": "cap.email_send",
          "note": "Agent sends the drafted reply via mail_mcp.send using MAIL_SVC_TOKEN, a shared account that can send to any address; the only safeguard is a single prompt rule."
        }
      ],
      "toxic_combination": [
        "in.inbound_email",
        "cap.crm_read",
        "cap.email_send"
      ],
