      "category": "containment",
      "mechanism": "structural",
      "capability_dependence": "independent",
      "decay_rationale": "Enforced by the filesystem MCP server's mount path independent of model behavior, but the mounted directory includes the .aws credentials folder, so it does not exclude sensitive paths.",
      "covers": [
        "cap.file_read"
      ],
      "status": "declared",
      "constrains_sink": false,
      "maestro_layer": "L4_deployment_infrastructure"
    },
    {
