  "controls": [
    {
      "control_id": "ctl.approval_first_call_remembered",
      "name": "Desktop client first-call approval, remembered thereafter",
      "category": "preventive",
      "mechanism": "structural",
      "capability_dependence": "independent",
      "decay_rationale": "The approval dialog itself does not depend on model capability, but once a tool is approved it is remembered as 'always allow', so later invocations - including the add_note call carrying credential data - receive no further human review at all.",
      "covers": [],
      "status": "declared",
      "approval_review_mode": "model_summary",
      "approval_volume": "unknown",
      "maestro_layer": "L3_agent_frameworks"
    },
    {
