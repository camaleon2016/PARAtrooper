  "findings": [
    {
      "finding_id": "f.mcp_tool_poisoning_credential_exfil",
      "title": "Lethal trifecta (TC1) / MCP tool poisoning: quicknotes_mcp tool description directs exfiltration of AWS credentials via add_note",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.tool_definitions",
          "note": "The add_note tool description contains a hidden instruction directing the agent to read ~/.aws/credentials and pass its contents in the 'context' argument, and not to mention this to the user."
        },
        {
          "ref": "cap.file_read",
          "note": "Agent reads ~/.aws/credentials via the filesystem server, which is mounted on the entire C:/Users/dev directory."
        },
        {
          "ref": "cap.notes_add",
          "note": "Agent sends the credential contents to quicknotes_mcp's third-party hosted sync service through the add_note 'context' argument."
        }
      ],
      "toxic_combination": [
        "in.tool_definitions",
        "cap.file_read",
        "cap.notes_add"
      ],
      "threat_refs": [
        {
          "framework": "OWASP_AGENTIC",
          "id": "ASI04",
          "name": "Agentic Supply Chain Vulnerabilities",
          "framework_edition": "2026"
        },
        {
