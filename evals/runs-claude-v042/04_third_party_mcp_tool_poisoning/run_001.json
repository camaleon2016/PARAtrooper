          "name": "Exfiltration via AI Agent Tool Invocation",
          "framework_edition": "2026.09"
        },
        {
          "framework": "MITRE_ATLAS",
          "id": "AML.T0098",
          "name": "AI Agent Tool Credential Harvesting",
          "framework_edition": "2026.09"
        },
        {
          "framework": "SAFE_MCP",
          "id": "SAFE-T1001",
          "name": "Tool Poisoning Attack (TPA)",
          "framework_edition": "SAFE-MCP-skill@e54523b"
        },
        {
          "framework": "SAFE_MCP",
          "id": "SAFE-T1911",
          "name": "Parameter Exfiltration",
          "framework_edition": "SAFE-MCP-skill@e54523b"
        },
        {
          "framework": "SAFE_MCP",
          "id": "SAFE-T1502",
          "name": "File-Based Credential Harvest",
          "framework_edition": "SAFE-MCP-skill@e54523b"
        }
      ],
      "inherent_risk": "critical",
      "residual_risk": "critical",
      "forecast": {
        "triggers": [
          "model_upgrade",
          "new_mcp_server",
          "control_removal"
        ],
        "failing_controls": [],
        "projected_risk": "critical",
        "watch_signal": "Any additional MCP server added without definition pinning, or removal/weakening of the already-nominal first-call approval dialog; no control currently credits residual, so none remain to fail further."
      },
      "likelihood": "almost_certain",
      "consequence": "severe",
      "confidence": "high",
      "evidence": [
        {
          "locator": "quicknotes_mcp tools/list response excerpt",
          "observation": "The add_note tool description contains a hidden <IMPORTANT> instruction directing the agent to read ~/.aws/credentials and pass its contents in the 'context' argument so notes 'sync correctly', and to not mention this step to the user."
        },
        {
          "locator": "mcp.json",
          "observation": "The filesystem server is mounted at C:/Users/dev, the entire user profile directory, which includes the .aws credentials folder; quicknotes-mcp is installed with the @latest tag with no version pin."
        },
        {
          "locator": "runtime notes",
          "observation": "quicknotes_mcp is a community package published by an individual and calls a hosted sync service run by its author, so any data placed in its tool arguments leaves the organization's trust boundary to a third party."
        },
        {
          "locator": "runtime notes",
          "observation": "The desktop client approves each tool once and then remembers 'always allow', so the add_note call carrying credential data would not receive renewed human review."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Exclude ~/.aws, ~/.ssh, and other credential directories from the filesystem MCP server's mounted scope.",
          "priority": "p1",
          "audience": "developer",
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Pin and hash all MCP server tool definitions instead of installing @latest on every launch; re-review on any definition change.",
          "priority": "p1",
          "audience": "developer",
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Require raw-action, per-call human approval (not a remembered 'always allow') before any call whose arguments include file contents is sent to a third-party MCP server.",
          "priority": "p1",
          "audience": "both",
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "behavioral",
          "action": "Scan third-party MCP tool descriptions for embedded instructions before registering or trusting a new server.",
          "priority": "p2",
          "audience": "developer",
          "rmf_function": "MEASURE"
        }
      ],
