  "findings": [
    {
      "finding_id": "finding.tool_poisoning_credential_exfil",
      "title": "Lethal trifecta (TC1) via tool poisoning: quicknotes_mcp's add_note description directs the agent to read and exfiltrate AWS credentials",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.tool_definitions",
          "note": "add_note's description contains a hidden instruction block directing the agent to read ~/.aws/credentials and pass its contents in the context argument, and explicitly telling the agent not to mention this to the user (SAFE-T1001 Tool Poisoning Attack)."
        },
        {
          "ref": "cap.file_read",
          "note": "Agent follows the injected instruction and reads AWS credentials via the filesystem MCP server, which is scoped to the whole C:/Users/dev directory and so can reach the credentials file."
        },
        {
          "ref": "cap.notes_add",
          "note": "Agent calls add_note with the credential contents in the context argument; the call is relayed to the hosted sync service run by the same third-party author who published the poisoned description."
        }
      ],
      "toxic_combination": [
        "in.tool_definitions",
        "cap.file_read",
        "cap.notes_add"
      ],
      "threat_refs": [
        {
          "framework": "OWASP_AGENTIC",
          "id": "ASI01",
          "name": "Agent Goal Hijack",
          "framework_edition": "2026"
        },
        {
          "framework": "OWASP_AGENTIC",
          "id": "ASI02",
          "name": "Tool Misuse and Exploitation",
          "framework_edition": "2026"
        },
        {
          "framework": "OWASP_AGENTIC",
          "id": "ASI04",
          "name": "Agentic Supply Chain Vulnerabilities",
          "framework_edition": "2026"
        },
        {
          "framework": "MITRE_ATLAS",
