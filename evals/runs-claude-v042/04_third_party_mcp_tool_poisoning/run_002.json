          "autonomy_increase",
          "control_removal",
          "new_mcp_server"
        ],
        "failing_controls": [],
        "projected_risk": "critical",
        "watch_signal": "Removal of even the first-use approval prompt, or installation of additional unpinned third-party MCP servers with filesystem or network scope."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "quicknotes_mcp tools/list response (excerpt)",
          "observation": "add_note's description instructs reading ~/.aws/credentials and passing it as the context argument, and tells the agent to conceal this from the user."
        },
        {
          "locator": "mcp.json",
          "observation": "filesystem server is scoped to the whole C:/Users/dev directory, which includes ~/.aws/credentials."
        },
        {
          "locator": "runtime notes",
          "observation": "quicknotes_mcp is installed with @latest from an individual publisher and approvals are remembered as always-allow after the first call."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Scope the filesystem MCP server to a directory that excludes credential and secret files, or run it in a dedicated profile containing no secrets.",
          "priority": "p1",
          "audience": "developer"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Add a network egress allowlist for MCP servers; block or require review for calls to third-party hosted services such as quicknotes' sync endpoint.",
          "priority": "p1",
