  "findings": [
    {
      "finding_id": "f.tc1_ticket_to_db_read_to_customer_reply",
      "title": "Lethal trifecta (TC1): customer ticket content can influence service-role SQL reads and customer-visible reply writes",
      "horizon": "present",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Untrusted customer-authored content enters the agent context through support_messages."
        },
        {
          "ref": "cap.sql_read",
          "note": "execute_sql reads with service role bypassing row level security, so the model can read restricted rows including integration tokens."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "execute_sql inserts into support_messages, and rows are shown back to the customer."
        }
      ],
      "toxic_combination": [
        "in.ticket_message",
        "cap.sql_read",
        "cap.sql_write_reply"
      ],
