      "inherent_risk": "critical",
      "residual_risk": "moderate",
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The database connection uses the service role, which bypasses row level security, and a table of integration tokens sits in the same database."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Customers write ticket messages through the public support widget, so ticket content is untrusted."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Rows in support_messages are shown back to the customer, so inserts into support_messages are an attacker-readable egress channel."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The IDE client asks the developer to approve each tool call and shows the SQL."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Developers approve many calls in a session, which is a condition for approval fatigue even though the gate is configured per call."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Replace the service-role database credential with a least-privilege credential that cannot read integration tokens or bypass row-level security for ticket workflows.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
