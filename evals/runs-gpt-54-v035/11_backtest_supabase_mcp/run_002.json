  "findings": [
    {
      "finding_id": "f1",
      "title": "Lethal trifecta (TC1): customer ticket content can drive service-role SQL read and customer-visible reply, enabling exfiltration to the customer",
      "horizon": "present",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Untrusted customer-authored content enters ticket context."
        },
        {
          "ref": "cap.sql_read",
          "note": "Agent can query the database with service-role credentials that bypass row level security and can read integration tokens."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "Agent can insert a reply into support_messages, and rows are shown back to the customer."
        }
      ],
      "toxic_combination": [
        "in.ticket_message",
        "cap.sql_read",
        "cap.sql_write_reply"
      ],
      "threat_refs": [
