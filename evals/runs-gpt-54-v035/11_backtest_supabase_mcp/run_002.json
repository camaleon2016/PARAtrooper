            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Bind customer reply writes to the current ticket record and approved fields so data read from other tables cannot be emitted to arbitrary customer-visible rows.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
