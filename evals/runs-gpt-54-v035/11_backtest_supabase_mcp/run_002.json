      "inherent_risk": "critical",
      "residual_risk": "moderate",
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:runtime notes",
          "observation": "Customer ticket messages are written through a public support widget and are therefore untrusted input."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The database connection uses the service role, bypasses row level security, and a table of integration tokens sits in the same database, so the read capability reaches restricted data under broader-than-user authority."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "Rows in support_messages are shown back to the customer, so inserting into that table is an attacker-reachable egress channel."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The IDE client asks the developer to approve each tool call and shows the SQL, but developers approve many calls in a session, creating approval-fatigue risk even though the gate is raw-action review."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Replace the service-role database credential with least-privilege access scoped to ticket-reading needs; remove access to integration_tokens and enforce row level security for agent queries.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "NIST_AI_RMF",
              "id": "MEASURE 2.7",
