  "findings": [
    {
      "finding_id": "fin.tc1_quicknotes_poisoned_exfil",
      "title": "Lethal trifecta (TC1): poisoned third-party MCP tool definition can induce credential file read and exfiltration to quicknotes sync",
      "horizon": "present",
      "attack_path": [
        {
          "ref": "in.tool_definitions",
          "note": "Untrusted tool description includes hidden instruction to read ~/.aws/credentials and send contents in context"
        },
        {
          "ref": "cap.file_read",
          "note": "Reads credential file from user home directory"
        },
        {
          "ref": "cap.notes_add",
          "note": "Arguments are sent to third-party hosted sync service"
        }
      ],
      "toxic_combination": [
        "in.tool_definitions",
        "cap.file_read",
        "cap.notes_add"
      ],
      "threat_refs": [
        {
          "framework": "OWASP_AGENTIC",
          "id": "ASI04",
          "name": "Agentic Supply Chain Vulnerabilities",
          "framework_edition": "2026"
        },
        {
          "framework": "OWASP_AGENTIC",
          "id": "ASI01",
          "name": "Agent Goal Hijack",
          "framework_edition": "2026"
        },
        {
          "framework": "MITRE_ATLAS",
          "id": "AML.T0010.005",
          "name": "AI Supply Chain Compromise: AI Agent Tool",
          "framework_edition": "2026.09"
        },
        {
          "framework": "MITRE_ATLAS",
          "id": "AML.T0051.001",
          "name": "LLM Prompt Injection: Indirect",
          "framework_edition": "2026.09"
        },
        {
          "framework": "SAFE_MCP",
          "id": "SAFE-T1001",
          "name": "Tool Poisoning Attack (TPA)",
          "framework_edition": "SAFE-MCP-skill@e54523b"
        },
        {
          "framework": "SAFE_MCP",
          "id": "SAFE-T1201",
          "name": "MCP Rug Pull Attack",
          "framework_edition": "SAFE-MCP-skill@e54523b"
        },
        {
          "framework": "SAFE_MCP",
          "id": "SAFE-T1911",
          "name": "Parameter Exfiltration",
          "framework_edition": "SAFE-MCP-skill@e54523b"
        }
      ],
      "inherent_risk": "critical",
      "residual_risk": "critical",
      "residual_rationale": "The only declared preventive control is remembered first-call approval, but it is not wired to the read capability and does not review later calls. Because the exfiltration path can proceed after an earlier benign approval of quicknotes and the approver may never see the hidden file-read side effect, the scored floor would be too low if this were treated as a real sink gate.",
      "forecast": {
        "triggers": [
          "new_mcp_server",
          "model_upgrade",
          "autonomy_increase",
          "control_removal"
        ],
        "failing_controls": [
          "ctl.first_call_tool_approval"
        ],
        "projected_risk": "critical",
        "watch_signal": "Any change to MCP client config, model version, or approval behavior; especially continued installation of quicknotes-mcp@latest and any relaxation of approval prompts."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:mcp.json",
          "observation": "quicknotes_mcp is launched from npx with quicknotes-mcp@latest, so the package and its tool definitions can change on every launch."
        },
        {
          "locator": "artifacts:quicknotes_mcp tools/list response excerpt",
          "observation": "The add_note description instructs the model to read ~/.aws/credentials, pass its contents in the context argument, and hide that step from the user."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp calls a hosted sync service run by its author, making add_note an attacker-reachable egress path."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "Approval is only on the first call to each tool and then remembered as always allow, so later quicknotes sends are unreviewed."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Pin quicknotes_mcp package version and tool definitions, and require review before any definition change is accepted.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "ISO_42001",
              "id": "A.10",
              "framework_edition": "2023"
            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Replace remembered always-allow with per-call approval for sensitive egress, showing raw destination and payload.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "NIST_SP_800_53",
              "id": "AC-5"
            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Constrain filesystem access so credential files and similar secret paths are unreadable to the agent.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "NIST_SP_800_53",
              "id": "AC-6"
            }
          ],
          "rmf_function": "MANAGE"
        }
      ],
