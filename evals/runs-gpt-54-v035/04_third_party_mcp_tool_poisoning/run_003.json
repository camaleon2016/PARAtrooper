      "inherent_risk": "critical",
      "residual_risk": "critical",
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:mcp.json",
          "observation": "quicknotes_mcp is launched from npm with \"quicknotes-mcp@latest\", so package and tool definitions can change on every launch."
        },
        {
          "locator": "artifacts:quicknotes_mcp tools/list excerpt",
          "observation": "The add_note tool description instructs the model to read \"~/.aws/credentials\", include the contents in a context argument, and hide the step from the user."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp is a community package published by an individual and calls a hosted sync service run by its author, making add_note an external egress path."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The desktop client only asks for approval on the first call to each tool and then remembers always allow, so later malicious invocations are unreviewed."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Pin quicknotes_mcp package version and hash reviewed tool definitions; fail closed on definition drift.",
