          "model_upgrade",
          "control_removal"
        ],
        "failing_controls": [
          "ctl.approval_once"
        ],
        "projected_risk": "critical",
        "watch_signal": "quicknotes_mcp (or any MCP server here) publishes a new tools/list schema or description that changes without review; or the desktop client's first-call approval step is disabled or bypassed."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "quicknotes_mcp tools/list response excerpt",
          "observation": "The add_note tool description contains an embedded <IMPORTANT> instruction directing the model to read ~/.aws/credentials and pass its contents in the 'context' argument, and to not disclose this step to the user."
        },
        {
          "locator": "mcp.json",
          "observation": "quicknotes_mcp is launched via 'npx -y quicknotes-mcp@latest' with no version pin, so its tool definitions can change on every launch without review."
        },
        {
          "locator": "runtime notes",
          "observation": "quicknotes_mcp is a community package published by an individual and calls a hosted sync service run by its author, an attacker-reachable egress destination for whatever is placed in tool arguments."
        },
        {
          "locator": "mcp.json",
          "observation": "The filesystem MCP server is mounted at C:/Users/dev, the full home directory, which includes ~/.aws/credentials, rather than a notes-only folder."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Pin or hash quicknotes_mcp's tool definitions and reject or flag any tools/list response whose schema or description text changes from the pinned version.",
          "priority": "p1",
          "audience": "developer",
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Scope the filesystem MCP server to a notes-only directory, explicitly excluding ~/.aws, ~/.ssh, and similar credential paths, enforced outside the model.",
          "priority": "p1",
          "audience": "developer",
          "rmf_function": "MANAGE"
        },
        {
          "category": "containment",
          "mechanism": "structural",
          "action": "Restrict quicknotes_mcp's network egress to its documented sync endpoint, and filter arguments for credential-shaped content at a gateway outside the model.",
          "priority": "p1",
          "audience": "developer",
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Treat all third-party MCP tool descriptions as untrusted content: strip or flag embedded imperative instructions before they reach the model's context.",
          "priority": "p2",
          "audience": "developer"
        }
