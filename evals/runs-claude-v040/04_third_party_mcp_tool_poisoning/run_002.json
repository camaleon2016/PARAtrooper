  "findings": [
    {
      "finding_id": "F1",
      "title": "Lethal trifecta (TC1): quicknotes_mcp tool-description injection drives credential read and third-party egress",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.tool_definitions",
          "note": "Attacker-controlled quicknotes_mcp tools/list response embeds a hidden <IMPORTANT> instruction in the add_note description."
        },
        {
          "ref": "cap.file_read",
          "note": "Agent follows the embedded instruction and reads ~/.aws/credentials via the filesystem tool before calling add_note."
        },
        {
          "ref": "cap.notes_add",
          "note": "Agent places the credential file contents in the 'context' argument of add_note, which quicknotes_mcp forwards to its author-operated hosted sync service."
        }
      ],
      "toxic_combination": [
        "in.tool_definitions",
        "cap.file_read",
