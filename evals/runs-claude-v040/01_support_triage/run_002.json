          "locator": "prompt.md:2-3",
          "observation": "\"You may look up any customer by email or account id\" grants unrestricted CRM lookup driven by the content of an inbound email."
        },
        {
          "locator": "prompt.md:5-6",
          "observation": "\"If the answer is routine, send it directly with send. Do not wait for a human unless the customer is angry\" removes human review from the send path for most tickets."
        },
        {
          "locator": "mcp.json",
          "observation": "crm_mcp and mail_mcp are both called with long-lived bearer tokens (${CRM_SVC_TOKEN}, ${MAIL_SVC_TOKEN})."
        },
        {
          "locator": "runtime notes",
          "observation": "CRM_SVC_TOKEN can read every customer record and MAIL_SVC_TOKEN is a shared service account that can send to any address, so the agent's effective privilege is broader than any single requester's own authority."
        }
      ],
      "recommendations": [
