      "residual_rationale": "The static token and unpinned card allow complete unauthorized capability execution, raising the risk above the moderate floor.",
      "forecast": {
        "triggers": [
          "new_peer_agent",
          "control_removal"
        ],
        "failing_controls": [],
        "projected_risk": "high",
        "watch_signal": "Agent card changes on the internal network"
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "runtime notes",
          "observation": "The agent card is fetched at startup and is not signed or pinned."
        },
        {
          "locator": "runtime notes",
          "observation": "payments-agent trusts any task from the orchestrator's bearer token, acting as a confused deputy."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Pin or cryptographically sign peer agent cards, and use OAuth or scoped mTLS for inter-agent authentication.",
