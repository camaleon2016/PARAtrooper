      "finding_id": "fnd.tc1",
      "title": "Lethal trifecta (TC1): Exfiltration of integration tokens via ticket reply",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.ticket_message"
        },
        {
          "ref": "cap.sql_read"
