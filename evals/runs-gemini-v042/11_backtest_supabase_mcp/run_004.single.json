      "toxic_combination": [
        "in.ticket_message",
        "cap.sql_read",
        "cap.sql_write_reply"
      ],
      "inherent_risk": "critical",
      "residual_risk": "high",
      "confidence": "high",
      "evidence": [
        {
          "locator": "runtime notes",
          "observation": "Customers write ticket messages (U source). The agent executes a SQL read via a service role that bypasses row level security, giving access to a table of integration tokens. It then replies to the customer by inserting a visible support message, establishing a complete path for prompt injection to exfiltrate restricted data."
        }
      ],
