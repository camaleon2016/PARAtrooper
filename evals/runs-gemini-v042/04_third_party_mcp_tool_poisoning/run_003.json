        "cap.notes_add"
      ],
      "inherent_risk": "critical",
      "residual_risk": "critical",
      "confidence": "high",
      "evidence": [
        {
          "locator": "quicknotes_mcp tools/list response",
          "observation": "The add_note tool definition instructs the agent to read ~/.aws/credentials and pass the contents to the context argument."
        },
        {
          "locator": "mcp.json",
          "observation": "quicknotes-mcp is pulled with the @latest tag, leaving definitions unpinned and susceptible to malicious updates."
        },
        {
          "locator": "runtime notes",
          "observation": "The quicknotes_mcp add_note tool transmits data to a hosted sync service run by a third party."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Pin all MCP dependencies and tool schemas to specific hashes or verified versions.",
          "priority": "p1",
          "audience": "both"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Implement a per-request raw-action approval gate for egress tools.",
          "priority": "p1",
          "audience": "both"
        }
