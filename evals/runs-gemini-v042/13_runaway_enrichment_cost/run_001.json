      "evidence": [
        {
          "locator": "runtime notes",
          "observation": "There is no maximum on steps, runtime, retries, or sub agents. 3 percent of rows have malformed company names that never return a complete result."
        },
        {
          "locator": "prompt.md:2-3",
          "observation": "Agent is explicitly instructed to 'retry, or spawn a researcher... Keep going until every row is complete.'"
        },
        {
          "locator": "runtime notes",
          "observation": "enrich.lookup is billed per call and the monthly quota is shared with sales and marketing teams."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Implement a hard max steps limit per row and max sub-agent depth limit.",
          "priority": "p1",
          "audience": "developer"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
