        "watch_signal": "Approval gate removed, narrowed, or effectively weakened as reviewers approve many SQL calls per session or task length rises."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Customer ticket messages are authored through a public support widget and are therefore untrusted input."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Database connection uses the service role and bypasses row level security; integration tokens sit in the same database."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Rows in support_messages are shown back to the customer, so SQL writes to that table are an attacker-reachable egress channel."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The IDE client asks the developer to approve each tool call and shows the SQL, but developers approve many calls in a session, so the gate is raw-action review at high volume."
        },
        {
          "locator": "artifacts:configuration",
          "observation": "The Supabase MCP server is loaded via @latest, so reviewed definitions are not pinned."
        }
      ],
