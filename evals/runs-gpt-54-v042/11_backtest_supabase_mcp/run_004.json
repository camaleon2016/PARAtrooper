  "findings": [
    {
      "finding_id": "fin.tc1_ticket_to_db_read_to_customer_visible_write",
      "title": "Lethal trifecta (TC1): customer ticket content can induce service-role database reads and write the result back to a customer-visible row",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Untrusted customer-authored content enters ticket context."
        },
        {
          "ref": "cap.sql_read",
          "note": "Agent can execute arbitrary SQL reads with a service role that bypasses row level security and can access integration tokens."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "Agent can insert support_messages rows that are shown back to the customer."
        }
      ],
      "toxic_combination": [
        "in.ticket_message",
        "cap.sql_read",
        "cap.sql_write_reply",
        "ctl.tool_call_prompt"
      ],
