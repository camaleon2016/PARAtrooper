        {
          "ref": "in.ticket_message",
          "note": "Customer-authored content enters the agent through support_messages."
        },
        {
          "ref": "cap.sql_read",
          "note": "execute_sql can read restricted data using a service role that bypasses row level security."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "execute_sql can insert a reply into support_messages, and those rows are shown back to the customer."
        }
      ],
