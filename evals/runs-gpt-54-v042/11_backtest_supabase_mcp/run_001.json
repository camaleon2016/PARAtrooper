    {
      "finding_id": "F4",
      "title": "Property finding: no attributable audit record separates agent SQL actions from developer identity",
      "horizon": "present",
      "finding_kind": "property",
      "affected_refs": [
        "cap.sql_read",
        "cap.sql_write_reply",
        "ide-db-agent",
