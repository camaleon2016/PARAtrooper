            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Make request transcripts and approval context immutable or write-once for retention periods that match production change review needs, so users cannot erase the only action rationale record.",
          "priority": "p1",
