        "projected_risk": "critical",
        "watch_signal": "Median steps per task or runtime per task rising, or autonomy already set to fully autonomous with no hard limits."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "prompt.md:2-3",
          "observation": "The prompt directs the agent to retry failed or incomplete lookups and to spawn a researcher sub agent, then to keep going until every row is complete."
        },
        {
          "locator": "runtime notes:1",
          "observation": "There is no maximum on steps, runtime, retries, or sub agents, and sub agents can spawn their own researchers."
        },
        {
          "locator": "runtime notes:3",
          "observation": "The nightly batch is 40,000 rows and about 3 percent have malformed company names that never return a complete result, creating a persistent failure set."
        },
        {
          "locator": "runtime notes:2",
          "observation": "enrich.lookup is billed per call and the API key and monthly quota are shared with sales and marketing, so depletion affects other teams."
        },
        {
          "locator": "runtime notes:4",
          "observation": "There is no spend alert on the enrichment account."
        }
      ],
      "recommendations": [
