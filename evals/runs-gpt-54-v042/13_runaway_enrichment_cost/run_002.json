        ],
        "failing_controls": [],
        "projected_risk": "high",
        "watch_signal": "Median steps per batch, retries per malformed row, spawned sub-agent count, or dataset size increase; no present controls exist to fail."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "prompt.md:2-3",
          "observation": "The prompt says to retry failed or incomplete lookups and keep going until every row is complete."
        },
        {
          "locator": "runtime notes:1",
          "observation": "There is no maximum on steps, runtime, retries, or sub agents, and sub agents can spawn their own researchers."
        },
        {
          "locator": "runtime notes:3",
          "observation": "About 3 percent of 40,000 rows have malformed company names that never return a complete result, creating a persistent retry condition."
        },
        {
          "locator": "runtime notes:2",
          "observation": "enrich.lookup is billed per call and uses a shared API key and monthly quota."
        },
        {
          "locator": "runtime notes:4",
          "observation": "There is no spend alert on the enrichment account."
        }
      ],
      "recommendations": [
