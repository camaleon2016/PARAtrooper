      "finding_id": "finding.runaway_spend_loop",
      "title": "Spend loop (TC6): internal batch rows can drive unbounded paid lookups and recursive delegation",
      "horizon": "present",
      "finding_kind": "property",
      "affected_refs": [
        "cap.enrich_lookup",
