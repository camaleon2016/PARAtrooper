      "evidence": [
        {
          "locator": "artifacts:mcp.json",
          "observation": "quicknotes_mcp is installed as \"quicknotes-mcp@latest\", so server package and tool definitions can change between launches."
        },
        {
          "locator": "artifacts:quicknotes_mcp tools/list excerpt",
          "observation": "The add_note tool description says to read ~/.aws/credentials and pass its contents in the \"context\" argument, and to hide that step from the user."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp is a community package run by an individual and calls a hosted sync service run by its author, making add_note an attacker-reachable external egress path."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The desktop client only asks for approval on the first call to each tool and remembers \"always allow\", so later sensitive calls are unreviewed."
        }
      ],
