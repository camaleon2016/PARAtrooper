      "evidence": [
        {
          "locator": "prompt.md:2-3",
          "observation": "The prompt instructs the agent to look up the customer's account with get_customer and says it may look up any customer by email or account id."
        },
        {
          "locator": "prompt.md:5-6",
          "observation": "The prompt allows the agent to send routine responses directly without waiting for a human."
        },
        {
          "locator": "prompt.md:14",
          "observation": "The only explicit confidentiality control in the prompt is an instruction not to share another customer's information."
        },
        {
          "locator": "runtime notes",
          "observation": "CRM_SVC_TOKEN can read every customer record, which gives the read step broad access beyond the emailing customer."
        },
        {
          "locator": "runtime notes",
          "observation": "MAIL_SVC_TOKEN is a shared service account that can send to any address, so the sink is irreversible egress with broad authority."
        },
        {
          "locator": "mcp.json",
          "observation": "Both MCP servers are configured with bearer service tokens, with no recipient binding or per-user scoping shown."
        }
      ],
