      "evidence": [
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Anyone on GitHub can open issues in the public repository, so issue content is an untrusted source."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The personal access token has repo scope across every repository the user owns, public and private, so the agent can read confidential private repositories with the user's delegated authority."
        },
        {
          "locator": "artifacts:stable_ids_and_notes",
          "observation": "Stable ids define get_file_contents on private repositories as cap.read_private_repo and create_pull_request on the public repository as cap.create_pr_public, forming a read-then-egress path."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The client asks for approval per tool call, but arguments are collapsed by default and users approve many calls per session; this is a model-summary, high-volume approval gate."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The user request is to look at open issues in a public repo, which does not authorize reading unrelated private repositories; using the user's PAT across all owned repos creates a confused deputy condition."
        }
      ],
