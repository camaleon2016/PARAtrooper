      "evidence": [
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Customer ticket messages are written through the public support widget and are therefore untrusted content."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The database connection uses the service role, bypasses row level security, and a table of integration tokens sits in the same database."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Rows inserted into support_messages are shown back to the customer, so database writes to that table create an attacker-readable egress channel."
