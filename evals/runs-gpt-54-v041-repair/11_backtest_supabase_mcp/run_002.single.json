  "findings": [
    {
      "finding_id": "f01",
      "title": "Lethal trifecta (TC1): customer ticket content can steer service-role SQL reads and write extracted data back to customer-visible rows",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Customer-authored content enters the agent through ticket rows."
        },
        {
          "ref": "cap.sql_read",
          "note": "execute_sql runs with service role and can read restricted data including integration tokens."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "Agent can insert into support_messages that the customer can read back."
        }
      ],
      "toxic_combination": [
        "in.ticket_message",
        "cap.sql_read",
        "cap.sql_write_reply",
        "ctl.tool_call_prompt"
      ],
      "threat_refs": [
