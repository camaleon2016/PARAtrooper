              "id": "AC-6"
            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Bind reply writes to the selected ticket and add a structural content check or recipient restriction so read data cannot be copied into customer-visible rows.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "NIST_AI_RMF",
