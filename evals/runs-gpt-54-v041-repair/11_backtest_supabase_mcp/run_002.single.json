        {
          "framework": "SAFE_MCP",
          "id": "SAFE-T1911",
          "name": "Parameter Exfiltration",
          "framework_edition": "SAFE-MCP-skill@e54523b"
        }
      ],
      "inherent_risk": "critical",
      "residual_risk": "high",
      "forecast": {
        "triggers": [
          "autonomy_increase",
          "model_upgrade",
          "control_removal",
          "longer_task_horizon"
        ],
        "failing_controls": [
          "ctl.tool_call_prompt"
        ],
        "projected_risk": "critical",
        "watch_signal": "Approval gate removed or narrowed, approvals per reviewer remain high, or IDE model/version changes."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Customer ticket messages are written through a public support widget and are therefore untrusted content."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The database connection uses the service role and bypasses row level security; a table of integration tokens sits in the same database."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Rows inserted into support_messages are shown back to the customer, making SQL write a hidden egress channel."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The IDE client asks the developer to approve each tool call and developers approve many calls in a session, so the approval gate is high volume."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Replace the service-role database access with credentials scoped to ticket tables only, so customer-controlled content cannot cause reads of integration tokens or unrelated restricted data.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "ISO_42001",
              "id": "A.6.2.6",
              "framework_edition": "2023"
            },
