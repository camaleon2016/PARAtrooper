  "findings": [
    {
      "finding_id": "f.tc1_customer_message_to_customer_visible_reply",
      "title": "Lethal trifecta (TC1): untrusted ticket message can drive service-role data read and customer-visible reply write",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Customer authored content enters through a public widget."
        },
        {
          "ref": "cap.sql_read",
          "note": "execute_sql can read restricted database content with a service role that bypasses row level security."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "execute_sql can insert a support_messages row visible back to the customer, creating an attacker-readable egress channel."
        }
      ],
      "toxic_combination": [
