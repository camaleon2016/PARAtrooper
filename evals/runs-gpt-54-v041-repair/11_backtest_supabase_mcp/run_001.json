        {
          "locator": "artifacts:runtime notes",
          "observation": "The database connection uses the service role and bypasses row level security; a table of integration tokens sits in the same database, so the read capability reaches restricted data with broader authority than the requester."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "Rows in support_messages are shown back to the customer, so inserts into that table are attacker-reachable egress."
