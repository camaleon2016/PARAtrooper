          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Execute production actions through a distinct service identity or brokered delegation flow so cloud audit logs can distinguish agent activity from the engineer's own direct actions.",
          "priority": "p1",
