      "title": "Summary gated irreversible payment and bank-change approval (TC9): untrusted invoice can steer payment scheduling and vendor bank updates through a model-summary approval card",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.supplier_invoice",
          "note": "Supplier-provided invoice content is untrusted and may contain altered payee or bank details."
        },
        {
          "ref": "cap.vendor_read",
          "note": "Agent reads vendor master to match vendor and compare details."
        },
        {
          "ref": "cap.bank_update",
          "note": "If invoice shows new bank details, agent updates vendor record using broad ERP authority."
        },
        {
          "ref": "cap.schedule_payment",
          "note": "Agent then schedules payment using ERP authority after clerk approval based only on the model summary."
        }
      ],
