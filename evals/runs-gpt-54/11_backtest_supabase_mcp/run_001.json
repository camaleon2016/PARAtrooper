        {
          "ref": "in.ticket_message",
          "note": "Untrusted customer-authored text enters ticket content."
        },
        {
          "ref": "cap.sql_read",
          "note": "execute_sql reads with service role that bypasses row level security, including sensitive tables in the same database."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "Agent can insert into support_messages, and rows are shown back to the customer."
        }
      ],
      "toxic_combination": [
