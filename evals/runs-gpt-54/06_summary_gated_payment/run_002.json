          "locator": "prompt.md:3-4",
          "observation": "The design requires approval before payment, but the approval is requested with a one line summary so the clerk can approve quickly."
        },
        {
          "locator": "approval card",
          "observation": "The clerk is shown only the summary \"Pay Northwind Supplies $4,200.00 for INV-1187 (matches PO-5521).\""
        },
        {
          "locator": "runtime notes",
          "observation": "The card does not show bank account numbers or change history, the clerk approves roughly 150 cards per day, and the ERP credential can schedule any payment."
        }
