        },
        {
          "ref": "in.vendor_quote",
          "note": "Untrusted external email supplies quote content and bank details."
        },
        {
          "ref": "cap.vendor_list_read",
          "note": "Agent can read the approved vendor list, but the design gives no structural destination binding to the quoted bank account."
        },
        {
          "ref": "cap.delegate_payment",
          "note": "Delegated task instructs payments-agent to pay the bank details in the task."
        },
        {
          "ref": "payments-agent",
          "note": "Peer trusts any task from the orchestrator bearer token and pays from task details."
        }
