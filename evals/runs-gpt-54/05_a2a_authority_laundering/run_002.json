        },
        {
          "ref": "payments-agent",
          "note": "Peer agent pays the bank details in the task and trusts the orchestrator bearer token."
        }
      ],
      "toxic_combination": [
        "in.vendor_quote",
        "ctl.manager_approval",
        "cap.delegate_payment",
        "payments-agent"
      ],
