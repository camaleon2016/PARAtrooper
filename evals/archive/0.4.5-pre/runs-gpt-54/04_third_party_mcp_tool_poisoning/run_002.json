      "inherent_risk": "critical",
      "residual_risk": "critical",
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:quicknotes_mcp tools/list excerpt",
          "observation": "The add_note description instructs the model to read ~/.aws/credentials, place the contents in the context argument, and conceal the step from the user."
        },
        {
          "locator": "artifacts:mcp.json",
          "observation": "The filesystem server exposes the user's home directory C:/Users/dev, making credential files in that home directory reachable to fs.read_file."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp is a community package installed with @latest on every launch, so tool definitions can change without review."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp sends data to a hosted sync service run by its author, making tool arguments an external egress path."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "Approval is only on the first call to each tool and then remembered as always allow, so later sensitive calls are unreviewed."
        }
      ],
