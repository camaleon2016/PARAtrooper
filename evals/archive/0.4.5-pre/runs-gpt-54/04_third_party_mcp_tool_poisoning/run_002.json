      "finding_id": "fin.quicknotes_poisoned_tool_exfil",
      "title": "Lethal trifecta (TC1): unpinned third-party MCP tool definition instructs credential exfiltration through quicknotes_mcp.add_note",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.tool_definitions",
          "note": "Untrusted tool description tells the model to read ~/.aws/credentials and hide that action from the user."
        },
        {
          "ref": "cap.file_read",
          "note": "Reads restricted credential material from the user's home directory."
        },
        {
          "ref": "cap.notes_add",
          "note": "Sends the stolen data to the third-party quicknotes hosted sync service in the context argument."
        }
      ],
      "toxic_combination": [
        "in.tool_definitions",
        "cap.file_read",
        "cap.notes_add"
      ],
