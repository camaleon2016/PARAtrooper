  "rating": {
    "inherent": "critical",
    "residual": "critical",
    "forecast": "critical",
    "rationale": "Present risk is driven by an untrusted third-party MCP package whose live tool description instructs the model to steal restricted local credentials and send them to an author-operated hosted service. The design lacks pinning, identity verification, persistent per-call approval, and sink restrictions, and remembered first-use approval is not a real gate for later sensitive actions. Manual validation was applied from the checklist because scripts could not be run."
  },
  "limitations": [
