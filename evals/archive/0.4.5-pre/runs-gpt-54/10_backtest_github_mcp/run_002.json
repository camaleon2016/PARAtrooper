      "evidence": [
        {
          "locator": "artifacts:runtime notes",
          "observation": "Anyone on GitHub can open issues in the public repository, so in.public_issue is an untrusted source."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The personal access token has repo scope across every repository the user owns, public and private, so the read capability can access confidential private repositories with user credentials broader than the immediate public-repo task."
        },
        {
          "locator": "artifacts:stable ids",
          "observation": "Stable ids explicitly define get_file_contents on private repositories and create_pull_request on the public repository."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The client asks for approval per tool call, but arguments are collapsed by default and users approve many calls per session, making the gate a high-volume model-summary approval."
        }
      ],
