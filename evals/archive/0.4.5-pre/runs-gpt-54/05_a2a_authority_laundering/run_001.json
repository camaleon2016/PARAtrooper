  "findings": [
    {
      "finding_id": "F1",
      "title": "Authority laundering (TC7): manager approval does not propagate to delegated payment task",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.purchase_request",
          "note": "Trusted purchase request obtains manager approval for item and budget before vendor quote exists."
        },
        {
          "ref": "ctl.manager_approval",
          "note": "Approval applies only to the purchase request and is not passed to the peer agent."
        },
        {
          "ref": "cap.delegate_payment",
          "note": "Orchestrator delegates payment details to payments-agent."
        },
        {
          "ref": "payments-agent",
          "note": "Peer agent pays bank details in the task based on orchestrator bearer token trust."
        }
      ],
      "toxic_combination": [
        "in.purchase_request",
        "ctl.manager_approval",
        "cap.delegate_payment",
        "payments-agent"
      ],
      "threat_refs": [
