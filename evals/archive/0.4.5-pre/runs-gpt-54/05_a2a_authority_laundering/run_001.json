          "name": "Cross-Agent Instruction Injection"
        }
      ],
      "inherent_risk": "moderate",
      "residual_risk": "moderate",
      "residual_rationale": "The rubric floor drops to low because the manager approval is a structural raw-action gate on a trusted input, but the design facts show that approval is not wired to the delegated payment sink: it occurs before any quote exists and the approval record is not propagated to payments-agent, so the sink remains effectively ungated.",
      "forecast": {
        "triggers": [
          "autonomy_increase",
          "control_removal",
          "intended_purpose_change"
        ],
        "failing_controls": [
          "ctl.manager_approval",
          "ctl.vendor_list_prompt_rule"
        ],
        "projected_risk": "high",
        "watch_signal": "Any change that removes manager review, broadens delegated payment scope, or changes orchestration so payment tasks are delegated without the current purchase-request approval checkpoint."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "prompt.md:1-4",
          "observation": "The orchestrator is instructed to hand the selected quote to payments-agent to pay and to rely on payments-agent for remaining checks."
        },
        {
          "locator": "runtime notes:1",
          "observation": "The manager approves item and budget before any quote exists, and that approval record is not passed to payments-agent."
        },
        {
          "locator": "runtime notes:2",
          "observation": "payments-agent trusts tasks from the orchestrator bearer token and pays the bank details in the task."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Propagate manager approval context to the delegated task and have payments-agent enforce that vendor, amount, and payee match the approved record before payment.",
          "priority": "p1",
          "audience": "both",
          "governance_refs": [
            {
              "framework": "ISO_42001",
              "id": "A.10",
              "framework_edition": "2023"
