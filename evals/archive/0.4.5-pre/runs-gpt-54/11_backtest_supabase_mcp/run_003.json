          "ref": "cap.sql_read",
          "note": "Agent can read the database with service-role privileges that bypass row level security, including integration tokens."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "Agent can insert into support_messages, and rows are shown back to the customer."
        }
