      "finding_id": "fin.tc1_sql_exfil_to_customer",
      "title": "Lethal trifecta (TC1): customer ticket content can steer service-role SQL reads and exfiltrate restricted database data back to the customer-visible support thread",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Untrusted customer-authored ticket content enters the agent context."
        },
        {
          "ref": "cap.sql_read",
          "note": "execute_sql runs with service role and can read restricted data including integration tokens."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "execute_sql can insert rows into support_messages, which are shown back to the customer."
        }
      ],
