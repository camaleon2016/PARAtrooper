        "failing_controls": [],
        "projected_risk": "high",
        "watch_signal": "Nightly row count rises, malformed-row rate rises, or median steps and API calls per row increase without new hard caps."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "prompt.md:1-3",
          "observation": "The instructions say to retry failed or incomplete lookups, spawn researcher sub agents, and keep going until every row is complete."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no maximum on steps, runtime, retries, or sub agents, and sub agents can spawn their own researchers."
        },
        {
          "locator": "runtime notes",
          "observation": "enrich.lookup is billed per call and uses an API key and monthly quota shared with sales and marketing; when the quota runs out, their tools stop working until the next month."
        },
        {
          "locator": "runtime notes",
          "observation": "About 3 percent of the 40,000 nightly rows have malformed company names that never return a complete result, creating a persistent trigger for retries and researcher spawning."
        },
        {
          "locator": "runtime notes",
          "observation": "There is no spend alert on the enrichment account."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Enforce a hard per-run and per-row cap on enrich.lookup calls, with quota partitioning so this agent cannot exhaust the shared monthly account.",
