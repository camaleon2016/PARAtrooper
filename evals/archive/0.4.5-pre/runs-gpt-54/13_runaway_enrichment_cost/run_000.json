      "finding_id": "fin.runaway_spend_loop",
      "title": "Spend loop (TC6): internal batch can drive unbounded paid API consumption and recursive delegation",
      "horizon": "present",
      "finding_kind": "property",
      "affected_refs": [
        "cap.enrich_lookup",
