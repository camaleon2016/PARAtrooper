      "inherent_risk": "critical",
      "residual_risk": "high",
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:runtime notes",
          "observation": "Anyone on GitHub can open issues in the public repository, so in.public_issue is untrusted content."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The personal access token has repo scope across every repository the user owns, public and private, making cap.read_private_repo a broad-credential read and enabling a confused-deputy step."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The client asks for approval per tool call, but arguments are collapsed by default and users approve many calls per session, so ctl.tool_call_prompt is a high-volume model-summary approval gate."
        },
        {
          "locator": "artifacts:stable ids and prompt text",
          "observation": "The user prompt is to look at open issues in the public repo, yet the design does not state any repository scoping that would prevent a later private repo read."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
