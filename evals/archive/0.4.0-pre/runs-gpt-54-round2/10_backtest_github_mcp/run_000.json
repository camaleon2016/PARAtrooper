  "findings": [
    {
      "finding_id": "f.tc1_public_issue_to_private_read_to_public_pr",
      "title": "Lethal trifecta (TC1): untrusted public issue content can steer private repository reads and exfiltrate via public pull request",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.public_issue",
          "note": "Public issue text is attacker-authorable and enters context while the agent reviews open issues."
        },
        {
          "ref": "cap.read_private_repo",
          "note": "Broad repo-scoped token allows reading private repositories outside the public repo named in the request."
        },
        {
          "ref": "cap.create_pr_public",
          "note": "Created pull request in the public repository can disclose private data in title, body, or diff."
        }
      ],
