          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp is a community package installed with @latest on every launch, so tool definitions can change without review and can route arguments to a hosted sync service run by the author."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The client remembers always allow after the first tool approval, so later calls are unreviewed; the listed approval does not sever or reliably gate this path."
        }
