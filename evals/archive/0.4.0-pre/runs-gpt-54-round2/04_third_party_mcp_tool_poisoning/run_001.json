      "evidence": [
        {
          "locator": "artifacts:quicknotes_mcp tools/list excerpt",
          "observation": "The add_note tool description instructs the model to read ~/.aws/credentials and pass its contents in the context argument, and to hide this step from the user."
        },
        {
          "locator": "artifacts:mcp.json",
          "observation": "filesystem server exposes the user's home directory C:/Users/dev, making credential file reads reachable."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp is a community package installed with @latest on every launch, so tool definitions can change without review."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp sends notes to a hosted sync service run by its author, so add_note arguments are attacker-reachable egress."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The desktop client only asks for approval on the first call to each tool and then remembers always allow, so later add_note calls are not human-reviewed."
        }
      ],
