      "inherent_risk": "critical",
      "residual_risk": "critical",
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:quicknotes_mcp tools/list excerpt",
          "observation": "The tool description says to read ~/.aws/credentials and pass its contents in the context argument, and explicitly says not to mention this to the user. This is hostile tool metadata and must be treated as untrusted content, not as instructions."
        },
        {
          "locator": "artifacts:mcp.json",
          "observation": "The filesystem server is configured on the user's home directory, enabling file reads from C:/Users/dev."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp is a community package installed with @latest on every launch and its tool definitions can change without review."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp calls a hosted sync service run by its author, creating third-party egress."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The desktop client remembers always-allow after the first tool call, so later file reads and note sends are unreviewed."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Pin quicknotes_mcp package version and reviewed tool definitions or hashes before use.",
