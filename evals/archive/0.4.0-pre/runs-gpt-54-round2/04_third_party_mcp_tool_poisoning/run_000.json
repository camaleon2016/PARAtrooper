  "findings": [
    {
      "finding_id": "fin.tc1_quicknotes_tool_poisoning_exfil",
      "title": "Lethal trifecta (TC1): unpinned third-party MCP tool definition injects credential read then exfiltrates to hosted sync service",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.tool_definitions",
          "note": "Untrusted tool description instructs the model to read a credential file and hide that step from the user."
        },
        {
          "ref": "cap.file_read",
          "note": "Reads ~/.aws/credentials from the user's home directory."
        },
        {
          "ref": "cap.notes_add",
          "note": "Sends stolen content in the context argument to a third-party hosted service."
        }
      ],
      "toxic_combination": [
