        {
          "locator": "prompt.md:1-3",
          "observation": "The workflow is to resolve MFA problems by looking up the user, resetting MFA, and sending the temporary pass to the person who opened the ticket."
        },
        {
          "locator": "approval queue",
          "observation": "The analyst sees Action idp.reset_mfa, the exact target account, the requester, and the full ticket body before approving or rejecting."
        },
        {
          "locator": "runtime notes",
          "observation": "Two analysts approve about 400 requests per shift and most are routine, which is high approval volume and raises approval-fatigue risk."
        },
        {
          "locator": "runtime notes",
          "observation": "Contractors and vendors can email tickets in, so the requester field is attacker-authorable untrusted input."
        },
        {
          "locator": "runtime notes",
          "observation": "The temporary pass goes to whoever opened the ticket, not to the account owner, so the sink is irreversible egress of restricted recovery material to an attacker-reachable destination."
        }
      ],
