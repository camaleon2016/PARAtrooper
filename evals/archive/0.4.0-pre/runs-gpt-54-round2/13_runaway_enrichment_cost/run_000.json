      "finding_id": "fin.runaway_spend_loop",
      "title": "Spend loop (TC6): unbounded retries and recursive delegation can exhaust shared paid API quota",
      "horizon": "present",
      "finding_kind": "property",
      "affected_refs": [
        "cap.enrich_lookup",
