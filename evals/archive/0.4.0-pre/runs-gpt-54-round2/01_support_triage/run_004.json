      "evidence": [
        {
          "locator": "prompt.md:2-3",
          "observation": "The agent is told to read the customer's email and look up their account with get_customer, and it may look up any customer by email or account id."
        },
        {
          "locator": "prompt.md:5-6",
          "observation": "Routine answers are sent directly with send and do not wait for a human."
        },
        {
          "locator": "prompt.md:14",
          "observation": "The only stated safeguard against disclosure is the prompt instruction not to share another customer's information."
        },
        {
          "locator": "runtime notes",
          "observation": "CRM_SVC_TOKEN can read every customer record, so the read capability is broader than the emailing principal's entitlement."
        },
        {
          "locator": "runtime notes",
          "observation": "MAIL_SVC_TOKEN is a shared service account that can send to any address, making the egress sink broad and irreversible."
        }
      ],
