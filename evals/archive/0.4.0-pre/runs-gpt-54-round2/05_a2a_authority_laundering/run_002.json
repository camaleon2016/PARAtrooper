  "findings": [
    {
      "finding_id": "F1",
      "title": "Authority laundering (TC7): manager approval does not propagate to delegated payment task",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.purchase_request",
          "note": "Trusted purchase request starts a legitimate procurement flow."
        },
        {
          "ref": "in.vendor_quote",
          "note": "Untrusted vendor quote supplies bank details from outside the company."
        },
        {
          "ref": "cap.delegate_payment",
          "note": "The orchestrator delegates payment details to payments-agent, which pays bank details in the task."
        },
        {
          "ref": "payments-agent",
          "note": "Peer agent executes payment based on task details without the original manager approval context."
        }
      ],
      "toxic_combination": [
        "in.purchase_request",
        "in.vendor_quote",
        "ctl.manager_approval",
        "cap.delegate_payment",
        "payments-agent"
      ],
      "threat_refs": [
