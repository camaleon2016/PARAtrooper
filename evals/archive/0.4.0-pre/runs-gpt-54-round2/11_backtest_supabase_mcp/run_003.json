    {
      "finding_id": "fin.tc1_customer_ticket_to_secret_exfil",
      "title": "Lethal trifecta (TC1): customer ticket message can induce service-role SQL read and exfiltrate secrets through customer-visible support_messages",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Untrusted customer-authored content enters the agent context through support tickets."
        },
        {
          "ref": "cap.sql_read",
          "note": "Agent can run execute_sql reads with a service role that bypasses row level security and can access integration tokens in the same database."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "Agent can insert rows into support_messages that are shown back to the customer, creating an attacker-readable egress channel."
        }
      ],
