          "framework_edition": "SAFE-MCP-skill@e54523b"
        }
      ],
      "inherent_risk": "critical",
      "residual_risk": "high",
      "forecast": {
        "triggers": [
          "autonomy_increase",
          "model_upgrade",
          "control_removal"
        ],
        "failing_controls": [
          "ctl.tool_call_prompt"
        ],
        "projected_risk": "critical",
        "watch_signal": "Approval prompt removed or remembered across calls, autonomy level raised, or model/version changes while approval volume remains high."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Customer ticket messages are written through a public support widget and appear in support_messages, so they are untrusted content."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The database connection uses the service role and bypasses row level security; a table of integration tokens sits in the same database, so the read capability reaches restricted data with broader-than-user authority."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Rows in support_messages are shown back to the customer, making SQL insert into that table an attacker-readable egress channel."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The IDE client asks the developer to approve each tool call and shows the SQL, but developers approve many calls in a session, so the gate is raw-action review at high volume and earns one tier of step-2 credit."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Replace the service-role read path with a least-privilege credential or server-side query interface that cannot read integration tokens or bypass tenant scoping.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "ISO_42001",
              "id": "A.6.2.6",
              "framework_edition": "2023"
            },
            {
              "framework": "NIST_SP_800_53",
              "id": "AC-6"
            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "containment",
          "mechanism": "structural",
          "action": "Constrain support-message writes so replies can only reference the current ticket and only emit approved fields or templates, preventing arbitrary database content from being copied into customer-visible rows.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "NIST_AI_RMF",
