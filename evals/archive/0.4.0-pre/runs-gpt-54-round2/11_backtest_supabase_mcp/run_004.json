  "findings": [
    {
      "finding_id": "f.tc1_ticket_to_db_to_customer",
      "title": "Lethal trifecta (TC1): customer ticket content can induce service-role SQL reads and data exfiltration back to the customer-visible ticket thread",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Untrusted customer-authored content enters context from public widget"
        },
        {
          "ref": "cap.sql_read",
          "note": "Agent can read restricted data with service role that bypasses row level security"
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "Agent can insert a reply into support_messages, which the customer can read back"
        }
      ],
      "toxic_combination": [
        "in.ticket_message",
        "cap.sql_read",
        "cap.sql_write_reply",
        "ctl.tool_call_prompt"
      ],
      "threat_refs": [
