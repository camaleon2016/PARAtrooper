  "findings": [
    {
      "finding_id": "f.tc1_ticket_to_reply_exfil",
      "title": "Lethal trifecta (TC1): customer ticket content can steer service-role SQL read and exfiltrate restricted data back to the customer-visible support_messages sink",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Untrusted customer-authored content enters ticket context."
        },
        {
          "ref": "cap.sql_read",
          "note": "execute_sql can read restricted data with service role and bypasses row level security."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "execute_sql can insert a reply row visible to the same customer."
        }
      ],
      "toxic_combination": [
        "in.ticket_message",
        "cap.sql_read",
        "cap.sql_write_reply",
        "ctl.tool_call_prompt"
      ],
      "threat_refs": [
        {
          "framework": "OWASP_AGENTIC",
          "id": "ASI01",
          "name": "Agent Goal Hijack",
          "framework_edition": "2026"
        },
        {
          "framework": "OWASP_AGENTIC",
          "id": "ASI02",
          "name": "Tool Misuse and Exploitation",
          "framework_edition": "2026"
        },
        {
          "framework": "MITRE_ATLAS",
          "id": "AML.T0051",
          "name": "LLM Prompt Injection",
          "framework_edition": "2026.09"
        },
        {
          "framework": "MITRE_ATLAS",
          "id": "AML.T0086",
          "name": "Exfiltration via AI Agent Tool Invocation",
          "framework_edition": "2026.09"
        },
        {
          "framework": "SAFE_MCP",
          "id": "SAFE-T1102",
          "name": "Prompt Injection (Multiple Vectors)",
          "framework_edition": "SAFE-MCP-skill@e54523b"
        },
        {
          "framework": "SAFE_MCP",
          "id": "SAFE-T1914",
          "name": "Tool-to-Tool Exfil",
          "framework_edition": "SAFE-MCP-skill@e54523b"
        }
      ],
      "inherent_risk": "critical",
      "residual_risk": "high",
      "forecast": {
        "triggers": [
          "autonomy_increase",
          "control_removal",
          "model_upgrade"
        ],
        "failing_controls": [
          "ctl.tool_call_prompt"
        ],
        "projected_risk": "critical",
        "watch_signal": "Any reduction in per-call approval, remembered approvals, or higher IDE approval volume; model/version change in client configuration."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:runtime notes",
          "observation": "Customers write ticket messages through the public support widget, so ticket content is untrusted and attacker-authorable."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The database connection uses the service role, which bypasses row level security, and a table of integration tokens sits in the same database."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "Rows in support_messages are shown back to the customer, so insert into support_messages is an attacker-readable egress path."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The IDE client asks the developer to approve each tool call and developers approve many calls in a session, so the approval gate is high volume."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Replace the service-role connection with a least-privilege credential scoped away from integration tokens and unrestricted ticket reads.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "NIST_SP_800_53",
              "id": "AC-6"
            },
            {
              "framework": "ISO_42001",
              "id": "A.6.2.6"
            }
          ],
          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Replace arbitrary execute_sql reply writes with a bound reply action that can only post to the developer-selected ticket and cannot include data from unrelated rows or token tables.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "NIST_SP_800_53",
              "id": "AC-3"
            },
            {
              "framework": "ISO_42001",
              "id": "A.6.2.6"
            }
          ],
          "rmf_function": "MANAGE"
        }
      ],
