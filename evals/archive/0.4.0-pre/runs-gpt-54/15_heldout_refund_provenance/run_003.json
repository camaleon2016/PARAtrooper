      "evidence": [
        {
          "locator": "runtime notes",
          "observation": "The agent calls the payments processor with one shared service account used by every support tool."
        },
        {
          "locator": "runtime notes",
          "observation": "The processor log records the service account, the amount, and the order, but not which staff member asked or why."
