          "rmf_function": "MANAGE"
        },
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Stop using a shared service account for refund issuance where the processor supports user-bound or delegated identity.",
          "priority": "p1",
          "audience": "developer",
          "governance_refs": [
            {
              "framework": "ISO_42001",
              "id": "A.6.2.6"
            },
            {
              "framework": "NIST_SP_800_53",
