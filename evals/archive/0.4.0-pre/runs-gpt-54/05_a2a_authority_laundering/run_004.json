        {
          "locator": "prompt.md:1-4",
          "observation": "The orchestrator is instructed to hand the chosen quote to payments-agent for payment and to rely on payments-agent for remaining checks."
        },
        {
          "locator": "runtime notes:1",
          "observation": "Manager approval occurs before any quote exists, so the approved record cannot cover vendor-selected bank details."
        },
        {
          "locator": "runtime notes:1",
          "observation": "The approval record is not passed to payments-agent, so delegated work is not bound to the original approval."
        },
        {
          "locator": "runtime notes:2",
          "observation": "payments-agent pays the bank details in the task whenever the task comes from the orchestrator bearer token."
        }
