      "title": "Lethal trifecta (TC1): public issue content can steer private repo reads and exfiltrate results through a public pull request",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.public_issue",
          "note": "Anyone on GitHub can author issue content in the public repository."
        },
        {
          "ref": "cap.read_private_repo",
          "note": "The PAT grants repo scope across every repository the user owns, including private repositories."
        },
        {
          "ref": "cap.create_pr_public",
          "note": "Creating a pull request on a public repository is attacker-readable egress and is irreversible once published."
        }
      ],
