      "evidence": [
        {
          "locator": "artifacts:configuration",
          "observation": "The design uses a GitHub MCP server via docker with the user's personal access token exposed to the container."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The token has repo scope across every repository the user owns, public and private, so private repo contents are reachable with broad credentials."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "Anyone on GitHub can open issues in the public repository, making issue content an untrusted source."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The client asks for approval per tool call, but arguments are collapsed by default and users approve many calls per session, which matches a high-volume model-summary gate."
        },
        {
          "locator": "artifacts:stable ids and design notes",
          "observation": "Stable ids explicitly identify get_file_contents on private repositories and create_pull_request on the public repository as capabilities in scope."
        }
      ],
