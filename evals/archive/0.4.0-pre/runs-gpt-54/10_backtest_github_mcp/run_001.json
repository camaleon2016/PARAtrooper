  "findings": [
    {
      "finding_id": "F1",
      "title": "Lethal trifecta (TC1): public issue content can induce read of private repositories and exfiltration through a public pull request",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.public_issue",
          "note": "Untrusted content from anyone on GitHub enters the agent context through public issues."
        },
        {
          "ref": "cap.read_private_repo",
          "note": "The MCP server can read private repository contents using the user's broad repo-scoped personal access token."
        },
        {
          "ref": "cap.create_pr_public",
          "note": "The agent can place data into a pull request on a public repository, which is attacker-readable egress."
        }
      ],
      "toxic_combination": [
