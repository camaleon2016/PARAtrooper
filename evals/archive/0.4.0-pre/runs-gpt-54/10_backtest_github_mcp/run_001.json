      "evidence": [
        {
          "locator": "artifacts:runtime notes",
          "observation": "Anyone on GitHub can open issues in the public repository, so issue text is an untrusted source."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The personal access token has repo scope across every repository the user owns, public and private, so the read capability reaches confidential private repository data with broad credentials."
        },
        {
          "locator": "artifacts:stable ids",
          "observation": "Stable ids explicitly identify get_file_contents on private repositories as cap.read_private_repo and create_pull_request on the public repository as cap.create_pr_public."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The client asks for approval per tool call, but arguments are collapsed by default and users approve many calls per session, so the gate is a high-volume model-summary approval rather than raw action review."
        }
