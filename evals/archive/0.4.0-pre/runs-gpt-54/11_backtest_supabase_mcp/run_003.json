      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Customers write ticket messages through the public support widget, so ticket content is untrusted."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The database connection uses the service role, which bypasses row level security, and a table of integration tokens sits in the same database."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Rows in support_messages are shown back to the customer, so SQL inserts there are an attacker-reachable egress channel."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The IDE client asks the developer to approve each tool call and developers approve many calls in a session, so the gate is high-volume."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Replace service-role reads with least-privilege credentials scoped away from integration tokens and other unrelated tables.",
