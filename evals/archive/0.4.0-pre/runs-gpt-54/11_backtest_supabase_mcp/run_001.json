        "failing_controls": [
          "ctl.tool_call_prompt"
        ],
        "projected_risk": "critical",
        "watch_signal": "Approval prompts reduced or batched, autonomy level raised, median tool calls per task rises, or model/version changes in the IDE client."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Customers write ticket messages through the public support widget, so ticket content is an untrusted source."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The database connection uses the service role, which bypasses row level security, and a table of integration tokens sits in the same database."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "Rows in support_messages are shown back to the customer, making SQL insert into that table an attacker-reachable egress channel."
        },
        {
          "locator": "artifacts:runtime_notes",
          "observation": "The IDE client asks the developer to approve each tool call and shows the SQL, but developers approve many calls in a session, so the gate earns only one tier of credit."
        }
      ],
      "recommendations": [
        {
