  "findings": [
    {
      "finding_id": "f01",
      "title": "Lethal trifecta (TC1): customer ticket content can induce restricted database reads and exfiltrate results through customer-visible support_messages",
      "horizon": "present",
      "finding_kind": "path",
      "attack_path": [
        {
          "ref": "in.ticket_message",
          "note": "Untrusted customer-authored content enters ticket rows."
        },
        {
          "ref": "cap.sql_read",
          "note": "Agent can execute SQL reads using a service role that bypasses row level security."
        },
        {
          "ref": "cap.sql_write_reply",
          "note": "Agent can insert a reply into support_messages that is shown back to the same customer."
        }
      ],
      "toxic_combination": [
        "in.ticket_message",
        "cap.sql_read",
        "cap.sql_write_reply",
        "ctl.tool_call_prompt"
      ],
      "threat_refs": [
