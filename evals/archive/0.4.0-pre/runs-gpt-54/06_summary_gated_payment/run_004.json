      "evidence": [
        {
          "locator": "prompt.md:1-4",
          "observation": "The prompt tells the agent to process supplier invoices, update vendor bank details when the invoice shows new bank details, and schedule payment."
        },
        {
          "locator": "prompt.md:3-4",
          "observation": "Before any payment or bank change, approval is requested with a one line summary so the clerk can approve quickly."
        },
        {
          "locator": "approval_card",
          "observation": "The clerk sees only a summary line: \"Pay Northwind Supplies $4,200.00 for INV-1187 (matches PO-5521).\""
        },
        {
          "locator": "runtime_notes",
          "observation": "The card does not show bank account numbers or change history, the clerk approves roughly 150 cards per day, the ERP credential can update any vendor and schedule any payment, and the model is upgraded with the platform with no separate review."
        }
      ],
      "recommendations": [
        {
          "category": "preventive",
          "mechanism": "structural",
          "action": "Replace summary-only approval with raw-action review that shows the exact bank account delta, vendor identity, prior change history, and scheduled payment destination before approval.",
