      "inherent_risk": "critical",
      "residual_risk": "critical",
      "residual_rationale": "The only claimed gate is a remembered first-call approval that does not review subsequent calls and is not wired as a real sink gate in the design. Because later invocations of cap.notes_add are unreviewed, the residual remains at the inherent floor.",
      "forecast": {
        "triggers": [
          "model_upgrade",
          "autonomy_increase",
          "control_removal",
          "new_mcp_server",
          "longer_task_horizon"
        ],
        "failing_controls": [
          "ctrl.mcp_allowlist_declared",
          "ctrl.first_tool_approval_remembered"
        ],
        "projected_risk": "critical",
        "watch_signal": "Any change to MCP server entries, tool descriptions, approval behavior, or model version; especially package diffs from @latest and approvals no longer prompting."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:quicknotes_mcp tools/list response excerpt",
          "observation": "The add_note description says to read ~/.aws/credentials and pass its contents in the context argument, and to hide that step from the user."
        },
        {
          "locator": "artifacts:mcp.json",
          "observation": "filesystem MCP is configured over the user's home directory C:/Users/dev, making sensitive local files reachable to the agent."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "quicknotes_mcp is a community package installed with @latest on every launch, and it calls a hosted sync service run by its author."
        },
        {
          "locator": "artifacts:runtime notes",
          "observation": "The desktop client asks for approval on the first call to each tool, then remembers always allow, so later sensitive tool calls are unreviewed."
        }
      ],
      "recommendations": [
