        "watch_signal": "Any desktop client change that removes the initial prompt, widens remembered approvals, upgrades the model, or adds MCP servers should trigger reassessment; current rating is already at the ceiling because remembered approval does not sever or narrow the path."
      },
      "confidence": "high",
      "evidence": [
        {
          "locator": "artifacts:mcp.json",
          "observation": "quicknotes_mcp is installed as \"quicknotes-mcp@latest\", so server code and tool definitions can change on every launch."
