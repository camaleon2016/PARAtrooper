{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/para/assessment.schema.json",
  "title": "PARA Agent Risk Assessment",
  "description": "Preemptive Agent Risk Assessment (working name). One document per agent. Designed so phase two can compose many assessments into a topology without reanalyzing each agent. Aligned to OWASP Agentic Top 10, MITRE ATLAS, CSA MAESTRO, STRIDE, NIST AI RMF, and ISO/IEC 42001.",
  "type": "object",
  "required": [
    "schema_version",
    "assessment",
    "subject",
    "capabilities",
    "inputs",
    "autonomy",
    "controls",
    "findings",
    "rating",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of this schema. Bump minor for additive fields, major for breaking changes. 0.2.0 adds governance alignment."
    },
    "assessment": {
      "type": "object",
      "required": [
        "assessment_id",
        "assessed_at",
        "assessor",
        "evidence_basis"
      ],
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "type": "string"
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "assessor": {
          "type": "object",
          "required": [
            "kind",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "skill",
                "tool",
                "human"
              ]
            },
            "version": {
              "type": "string"
            },
            "model": {
              "type": "string",
              "description": "Model used for judgment steps, if any. Needed to study run to run consistency."
            },
            "rubric_version": {
              "type": "string"
            }
          }
        },
        "evidence_basis": {
          "enum": [
            "declared",
            "discovered",
            "declared_and_discovered"
          ],
          "description": "declared = what the team provided; discovered = what the tool observed. Drift between the two is reported as a finding."
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artifact_type",
              "locator"
            ],
            "additionalProperties": false,
            "properties": {
              "artifact_type": {
                "enum": [
                  "system_prompt",
                  "tool_manifest",
                  "mcp_config",
                  "agent_card",
                  "iac",
                  "source_code",
                  "runtime_config",
                  "documentation",
                  "other"
                ]
              },
              "locator": {
                "type": "string",
                "description": "Path, URL, or reference."
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        },
        "assessment_reason": {
          "enum": [
            "initial",
            "planned_interval",
            "significant_change",
            "incident",
            "on_request"
          ],
          "description": "ISO 42001 8.2 requires assessment at planned intervals and on significant change."
        },
        "change_triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forecast_trigger"
          },
          "description": "The significant changes that caused this reassessment, if any."
        },
        "previous_assessment_id": {
          "type": "string",
          "description": "Links reassessments so results stay comparable over time."
        }
      }
    },
    "subject": {
      "type": "object",
      "required": [
        "agent_id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "type": "string",
          "description": "Stable identifier used as a node id in topology graphs."
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "trust_domain": {
          "enum": [
            "first_party",
            "third_party",
            "unknown"
          ],
          "description": "Third party and unknown agents default to untrusted in composition analysis."
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "swappable": {
              "type": "boolean",
              "description": "True if the model can be upgraded without a new review. Feeds the model_upgrade forecast trigger."
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "action",
          "target",
          "reversibility",
          "data_sensitivity"
        ],
        "additionalProperties": false,
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "tool_ref": {
            "type": "string",
            "description": "Tool name or MCP server and tool."
          },
          "action": {
            "enum": [
              "read",
              "write",
              "delete",
              "execute",
              "send_external",
              "spend",
              "delegate",
              "credential_access",
              "configure"
            ]
          },
          "target": {
            "type": "string",
            "description": "Resource acted on, for example a mailbox, repo, or database."
          },
          "data_sensitivity": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "reversibility": {
            "enum": [
              "reversible",
              "partially_reversible",
              "irreversible"
            ]
          },
          "is_egress": {
            "type": "boolean",
            "description": "Can move data outside the trust boundary."
          },
          "approval_gate_ref": {
            "type": "string",
            "description": "control_id of a human approval control, if one gates this capability."
          },
          "credential_scope": {
            "enum": [
              "least_privilege",
              "broad",
              "user_delegated",
              "shared_service_account",
              "unknown"
            ]
          },
          "maestro_layer": {
            "$ref": "#/$defs/maestro_layer"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input_id",
          "source",
          "trust_level"
        ],
        "additionalProperties": false,
        "properties": {
          "input_id": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "User prompt, web content, email, ticket, file, peer agent, tool output, and so on."
          },
          "trust_level": {
            "enum": [
              "trusted",
              "internal",
              "untrusted",
              "unknown"
            ]
          },
          "from_agent_id": {
            "type": "string",
            "description": "Set when the input comes from another agent. Creates an edge in phase two."
          },
          "reaches_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "capability_ids this input can influence."
          }
        }
      }
    },
    "autonomy": {
      "type": "object",
      "required": [
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "A0_suggest_only",
            "A1_act_with_approval_each_step",
            "A2_act_with_approval_on_sensitive",
            "A3_act_then_report",
            "A4_fully_autonomous"
          ]
        },
        "max_unattended_steps": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_runtime_minutes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "can_spawn_agents": {
          "type": "boolean"
        },
        "can_modify_own_config": {
          "type": "boolean"
        }
      }
    },
    "instructions": {
      "type": "array",
      "description": "Observations about the system prompt or instructions that raise risk.",
      "items": {
        "type": "object",
        "required": [
          "issue",
          "severity"
        ],
        "additionalProperties": false,
        "properties": {
          "issue": {
            "enum": [
              "ambiguous_goal",
              "conflicting_directives",
              "implied_authority",
              "secret_in_prompt",
              "unbounded_scope",
              "safety_by_instruction_only",
              "other"
            ]
          },
          "evidence_locator": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/$defs/tier"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "protocols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "protocol",
          "peer_ref",
          "direction"
        ],
        "additionalProperties": false,
        "properties": {
          "protocol": {
            "enum": [
              "mcp",
              "a2a",
              "http_api",
              "message_queue",
              "other"
            ]
          },
          "peer_ref": {
            "type": "string",
            "description": "MCP server id or peer agent_id. Becomes an edge in phase two."
          },
          "direction": {
            "enum": [
              "outbound",
              "inbound",
              "bidirectional"
            ]
          },
          "auth_method": {
            "enum": [
              "none",
              "static_token",
              "oauth",
              "mtls",
              "signed_identity",
              "unknown"
            ]
          },
          "peer_identity_verified": {
            "type": "boolean"
          },
          "definitions_pinned": {
            "type": "boolean",
            "description": "Tool definitions or agent card are version pinned or hashed, which counters rug pulls."
          },
          "peer_trust_level": {
            "enum": [
              "trusted",
              "internal",
              "untrusted",
              "unknown"
            ]
          },
          "technique_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/threat_ref"
            }
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "name",
          "category",
          "mechanism",
          "capability_dependence",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "control_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "enum": [
              "preventive",
              "detective",
              "containment",
              "corrective"
            ]
          },
          "mechanism": {
            "enum": [
              "structural",
              "behavioral"
            ],
            "description": "structural = enforced outside the model (sandbox, scoped credential, egress rule). behavioral = relies on the model complying (prompt instruction, self check)."
          },
          "capability_dependence": {
            "enum": [
              "independent",
              "partially_dependent",
              "dependent"
            ],
            "description": "Whether effectiveness decays as model capability grows. This drives the forecast."
          },
          "decay_rationale": {
            "type": "string"
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "capability_ids or input_ids this control protects."
          },
          "status": {
            "enum": [
              "declared",
              "verified",
              "missing_recommended"
            ]
          },
          "maestro_layer": {
            "$ref": "#/$defs/maestro_layer"
          },
          "governance_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/governance_ref"
            },
            "description": "ISO 42001 Annex A, NIST 800-53, or COSAiS controls this implements."
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "title",
          "horizon",
          "inherent_risk",
          "residual_risk",
          "confidence",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "horizon": {
            "enum": [
              "present",
              "forecast"
            ],
            "description": "present = the path exists now. forecast = the path opens when a trigger occurs."
          },
          "attack_path": {
            "type": "array",
            "description": "Ordered steps from source to sink, each referencing ids in this document.",
            "items": {
              "type": "object",
              "required": [
                "ref"
              ],
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "toxic_combination": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "ids that are safe alone but risky together."
          },
          "threat_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/threat_ref"
            }
          },
          "inherent_risk": {
            "$ref": "#/$defs/tier"
          },
          "residual_risk": {
            "$ref": "#/$defs/tier"
          },
          "forecast": {
            "type": "object",
            "required": [
              "triggers",
              "failing_controls",
              "projected_risk"
            ],
            "additionalProperties": false,
            "properties": {
              "triggers": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/forecast_trigger"
                }
              },
              "failing_controls": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "control_ids expected to fail first when a trigger occurs."
              },
              "projected_risk": {
                "$ref": "#/$defs/tier"
              },
              "watch_signal": {
                "type": "string",
                "description": "What to monitor so the team knows the trigger has occurred."
              }
            }
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "locator",
                "observation"
              ],
              "additionalProperties": false,
              "properties": {
                "locator": {
                  "type": "string"
                },
                "observation": {
                  "type": "string"
                }
              }
            }
          },
          "recommendations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "category",
                "mechanism",
                "action",
                "priority"
              ],
              "additionalProperties": false,
              "properties": {
                "category": {
                  "enum": [
                    "preventive",
                    "detective",
                    "containment",
                    "corrective"
                  ]
                },
                "mechanism": {
                  "enum": [
                    "structural",
                    "behavioral"
                  ]
                },
                "action": {
                  "type": "string"
                },
                "priority": {
                  "enum": [
                    "p1",
                    "p2",
                    "p3"
                  ]
                },
                "audience": {
                  "enum": [
                    "developer",
                    "reviewer",
                    "both"
                  ]
                },
                "governance_refs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/governance_ref"
                  }
                },
                "rmf_function": {
                  "enum": [
                    "GOVERN",
                    "MAP",
                    "MEASURE",
                    "MANAGE"
                  ]
                }
              }
            }
          },
          "stride": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/stride"
            },
            "description": "STRIDE classes. May be empty for agentic threats STRIDE does not cover, such as goal hijack."
          },
          "agentic_class": {
            "type": "array",
            "items": {
              "enum": [
                "goal_manipulation",
                "autonomy_abuse",
                "memory_poisoning",
                "cascading_failure",
                "collusion",
                "human_trust_exploitation"
              ]
            },
            "description": "Agentic threat classes beyond STRIDE."
          },
          "maestro_layers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/maestro_layer"
            },
            "description": "Layers the attack path crosses."
          },
          "governance_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/governance_ref"
            }
          },
          "likelihood": {
            "enum": [
              "rare",
              "unlikely",
              "possible",
              "likely",
              "almost_certain"
            ],
            "description": "Needed for ISO 42001 6.1.2 analysis of likelihood and consequence."
          },
          "consequence": {
            "enum": [
              "minor",
              "moderate",
              "major",
              "severe"
            ]
          },
          "treatment": {
            "type": "object",
            "required": [
              "option"
            ],
            "additionalProperties": false,
            "description": "ISO 42001 6.1.3 risk treatment.",
            "properties": {
              "option": {
                "enum": [
                  "mitigate",
                  "accept",
                  "transfer",
                  "avoid",
                  "pending"
                ]
              },
              "owner": {
                "type": "string"
              },
              "approved_by": {
                "type": "string",
                "description": "Management approval, required for accepted residual risk."
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              },
              "review_by": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    },
    "rating": {
      "type": "object",
      "required": [
        "inherent",
        "residual",
        "forecast",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "inherent": {
          "$ref": "#/$defs/tier"
        },
        "residual": {
          "$ref": "#/$defs/tier"
        },
        "forecast": {
          "$ref": "#/$defs/tier"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "composition": {
      "type": "object",
      "description": "Phase two hooks. What this agent exposes to and accepts from peers.",
      "additionalProperties": false,
      "properties": {
        "accepts_tasks_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delegates_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_consumers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval_context_propagates": {
          "type": "boolean",
          "description": "Whether human approval context travels with delegated work. False signals authority laundering risk."
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Must include a statement that the assessment reflects design and configuration, not observed runtime behavior."
    }
  },
  "$defs": {
    "tier": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "threat_ref": {
      "type": "object",
      "required": [
        "framework",
        "id",
        "framework_edition"
      ],
      "additionalProperties": false,
      "properties": {
        "framework": {
          "enum": [
            "OWASP_AGENTIC",
            "OWASP_LLM_TOP10",
            "MITRE_ATLAS",
            "SAFE_MCP",
            "COSAI",
            "OTHER"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "framework_edition": {
          "type": "string",
          "description": "Edition or version, for example 2026 or v5.4.0. Required for unambiguous ids across editions."
        }
      }
    },
    "governance_ref": {
      "type": "object",
      "required": [
        "framework",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "framework": {
          "enum": [
            "NIST_AI_RMF",
            "NIST_AI_600_1",
            "ISO_42001",
            "NIST_SP_800_53",
            "NIST_COSAIS",
            "IMDA_MGF_AGENTIC",
            "OTHER"
          ]
        },
        "id": {
          "type": "string",
          "description": "Function and subcategory (MEASURE 2.7), clause (8.2), Annex A control, or 800-53 control id."
        },
        "framework_edition": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "maestro_layer": {
      "enum": [
        "L1_foundation_models",
        "L2_data_operations",
        "L3_agent_frameworks",
        "L4_deployment_infrastructure",
        "L5_evaluation_observability",
        "L6_security_compliance",
        "L7_agent_ecosystem"
      ],
      "description": "CSA MAESTRO layer."
    },
    "stride": {
      "enum": [
        "spoofing",
        "tampering",
        "repudiation",
        "information_disclosure",
        "denial_of_service",
        "elevation_of_privilege"
      ]
    },
    "forecast_trigger": {
      "enum": [
        "model_upgrade",
        "new_tool",
        "new_mcp_server",
        "new_peer_agent",
        "autonomy_increase",
        "control_removal",
        "longer_task_horizon",
        "data_scope_expansion",
        "intended_purpose_change"
      ],
      "description": "Doubles as the documented significant change criteria for ISO 42001 8.2."
    }
  }
}